  .toast{ position:absolute; top:14%; left:50%; transform:translateX(-50%); z-index:15;
    background:rgba(0,0,0,.75); border:1px solid var(--gold); color:var(--gold-soft);
    font-size:1.05rem; font-weight:800; padding:.5rem 1.2rem; border-radius:12px;
    pointer-events:none; opacity:0; transition:opacity .25s; white-space:nowrap; }
  .toast.show{ opacity:1; }

  /* ══ 動畫（雀神感） ══ */
  /* 發牌：逐張滑入 */
  @keyframes dealIn{ from{ transform:translateY(22px) scale(.72); opacity:0; } to{ transform:none; opacity:1; } }
  .cell.deal{ animation:dealIn .4s cubic-bezier(.2,1.4,.4,1) both; }
  /* 摸牌：彈跳登場 */
  @keyframes popIn{ 0%{ transform:scale(.25) rotate(-10deg); opacity:0; } 62%{ transform:scale(1.14) rotate(2deg); } 100%{ transform:none; opacity:1; } }
  .cell.pop{ animation:popIn .34s cubic-bezier(.2,1.2,.4,1) both; }
  /* 棄牌：落河 */
  @keyframes riverDrop{ 0%{ transform:translateY(-16px) scale(1.4); opacity:0; } 68%{ transform:translateY(2px) scale(.96); } 100%{ transform:none; opacity:1; } }
  .river .tile.drop{ animation:riverDrop .32s ease-out both; }
  /* 教練推薦：呼吸金光 */
  @keyframes recPulse{
    0%,100%{ box-shadow:0 0 8px rgba(245,184,0,.35); }
    50%{ box-shadow:0 0 18px rgba(245,184,0,.85); } }
  .cell.rec .tile{ animation:recPulse 1.6s ease-in-out infinite; }
  /* 輪到誰：邊框脈動 */
  @keyframes turnPulse{
    0%,100%{ box-shadow:0 0 0 1px var(--gold),0 0 8px rgba(245,184,0,.2); }
    50%{ box-shadow:0 0 0 1px var(--gold),0 0 16px rgba(245,184,0,.5); } }
  .oc.turn{ animation:turnPulse 1.4s ease-in-out infinite; }
  /* 選牌浮起：彈簧 */
  .cell .tile{ transition:transform .16s cubic-bezier(.2,1.6,.4,1); }
  /* 大字特效（碰/吃/胡/自摸/流局） */
  #uCallout{ position:absolute; top:36%; left:50%; transform:translate(-50%,-50%); z-index:18;
    pointer-events:none; opacity:0; text-align:center; }
  #uCallout .co{ font-size:3.4rem; font-weight:900; letter-spacing:.08em; line-height:1.1;
    text-shadow:0 0 24px currentColor,0 4px 10px rgba(0,0,0,.6); -webkit-text-stroke:2px rgba(0,0,0,.35); }
  #uCallout .co-sub{ font-size:.95rem; font-weight:800; color:#fff; text-shadow:0 2px 6px rgba(0,0,0,.7); margin-top:.2rem; }
  @keyframes calloutGo{
    0%{ transform:translate(-50%,-50%) scale(2.4); opacity:0; }
    22%{ transform:translate(-50%,-50%) scale(1); opacity:1; }
    72%{ transform:translate(-50%,-50%) scale(1); opacity:1; }
    100%{ transform:translate(-50%,-50%) scale(.88); opacity:0; } }
  #uCallout.go{ animation:calloutGo 1.05s cubic-bezier(.2,1,.4,1) both; }
  /* 結算面板：縮放進場＋台數逐行揭示 */
  @keyframes panelIn{ from{ transform:scale(.8); opacity:0; } to{ transform:none; opacity:1; } }
  .panel{ animation:panelIn .38s cubic-bezier(.2,1.3,.4,1) both; }
  @keyframes rowIn{ from{ opacity:0; transform:translateX(-16px); } to{ opacity:1; transform:none; } }
  .score-table tr.srow{ animation:rowIn .34s ease-out both; }
  /* ── 飛牌：打出的牌從手上/對手飛進牌河 ── */
  .fly{ position:fixed; z-index:30; pointer-events:none; will-change:transform;
    transition:transform .42s cubic-bezier(.3,.9,.35,1), opacity .42s ease; }
  .fly .tface{ width:100%; height:100%; display:block;
    filter:drop-shadow(0 8px 14px rgba(0,0,0,.55)); }
  .river .tile.landing{ opacity:0; }

  /* ── 氈面呼吸光（環境動態） ── */
  .screen::before{ content:''; position:absolute; inset:-20%; pointer-events:none; z-index:0;
    background:radial-gradient(closest-side, rgba(120,255,190,.10), transparent 70%);
    animation:feltGlow 9s ease-in-out infinite; }
  @keyframes feltGlow{
    0%,100%{ transform:translate(-6%,-4%) scale(1); opacity:.55; }
    50%{ transform:translate(6%,5%) scale(1.15); opacity:.9; } }
  .top,.oppo,.river,.coach,.mine-extra,.hand-zone,.win-prompt{ position:relative; z-index:1; }

  /* ── 輪到你：手牌區亮起 ── */
  @keyframes myTurnGlow{
    0%,100%{ box-shadow:inset 0 1px 0 rgba(255,255,255,.06), 0 -6px 20px -8px rgba(245,184,0,.35); }
    50%{ box-shadow:inset 0 1px 0 rgba(255,255,255,.06), 0 -6px 26px -6px rgba(245,184,0,.75); } }
  .hand-zone.my-turn{ animation:myTurnGlow 2s ease-in-out infinite; }

  /* ── 聽牌了：資訊條脈動 ── */
  @keyframes tenpaiPulse{
    0%,100%{ border-color:var(--line); }
    50%{ border-color:var(--gold); box-shadow:0 0 12px rgba(245,184,0,.4); } }
  .chip.tenpai{ animation:tenpaiPulse 1.5s ease-in-out infinite; }

  /* ── 副露翻轉進場 ── */
  @keyframes meldFlip{ from{ transform:rotateY(90deg) scale(.7); opacity:0; } to{ transform:none; opacity:1; } }
  .mine-meld.fresh, .oc-meld.fresh{ animation:meldFlip .4s cubic-bezier(.2,1.2,.4,1) both; }

  /* ── 牌牆數字跳動 ── */
  @keyframes wallBump{ 0%{ transform:scale(1); } 40%{ transform:scale(1.28); color:var(--gold-soft); } 100%{ transform:scale(1); } }
  .wall .n.bump{ animation:wallBump .32s ease-out; }

  /* ── 胡牌光芒爆發 ── */
  #uBurst{ position:absolute; inset:0; z-index:17; pointer-events:none; opacity:0; }
  #uBurst.go{ animation:burstFade 1.4s ease-out both; }
  @keyframes burstFade{ 0%{ opacity:1; } 100%{ opacity:0; } }
  #uBurst .ring{ position:absolute; top:36%; left:50%; width:40px; height:40px; margin:-20px 0 0 -20px;
    border-radius:50%; border:3px solid var(--gold); animation:ringOut 1.1s cubic-bezier(.15,.8,.3,1) both; }
  #uBurst .ring:nth-child(2){ animation-delay:.14s; border-color:#fff8d0; }
  #uBurst .ring:nth-child(3){ animation-delay:.28s; border-color:rgba(245,184,0,.6); }
  @keyframes ringOut{ from{ transform:scale(.2); opacity:.95; } to{ transform:scale(11); opacity:0; } }
  #uBurst .spark{ position:absolute; top:36%; left:50%; width:7px; height:7px; margin:-3.5px 0 0 -3.5px;
    border-radius:50%; background:var(--gold-soft); animation:sparkOut 1s ease-out both; }
  @keyframes sparkOut{ from{ transform:translate(0,0) scale(1); opacity:1; }
    to{ transform:translate(var(--dx),var(--dy)) scale(.2); opacity:0; } }

  @media (prefers-reduced-motion: reduce){ *{ animation:none!important; transition:none!important; } }
</style>
</head>
<body>
<div class="screen">
  <div class="top">
