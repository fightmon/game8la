  <div id="uBurst"></div>
  <div class="overlay" id="uStart">
    <div class="panel">
      <h2>🀄 台麻練習桌</h2>
      <p class="sub">你（東家莊）對戰 3 個 AI。<br>教練會即時建議打哪張、顯示向聽與進張。<br>點一下選牌，<b>再點同一張</b>就打出。</p>
      <div class="stake-pick">
        <div class="sp-label">選底台 <small>（用眼光點當籌碼，輸光隔天自動補滿）</small></div>
        <div class="sp-row" id="uStakeRow">
          <button class="sp on" data-b="10" data-t="10">練習<small>10 / 10</small></button>
          <button class="sp" data-b="50" data-t="50">家庭局<small>50 / 50</small></button>
          <button class="sp" data-b="100" data-t="100">大局<small>100 / 100</small></button>
