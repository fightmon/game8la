<script type="module" is:inline>
import { TILE_NAMES, KINDS } from '/mahjong/core/tiles.mjs';
import { shanten } from '/mahjong/core/shanten.mjs';
import { usefulTiles } from '/mahjong/core/ukeire.mjs';
import { rankDiscards, evalClaim, evalKong } from '/mahjong/ai/discard.mjs';
import { Game, aiController } from '/mahjong/game/flow.mjs';
import { strToKind, scoreWin } from '/mahjong/core/decompose.mjs';
import { tileFaceSVG, TILE_DEFS } from '/mahjong/tiles-svg.mjs';
import { dangerOf, dangerLabel, threatOf } from '/mahjong/ai/defense.mjs';

/* ── 牌面：與 game8la 算台練習器同一套（一萬/一索鳥/一筒大餅） ── */
document.body.insertAdjacentHTML('afterbegin', TILE_DEFS);
function tileHTML(k,size){ return `<div class="tile ${size||''}">${tileFaceSVG(k)}</div>`; }
const FLOWER_NAMES=['','春','夏','秋','冬','梅','蘭','竹','菊'];

/* ── 遊戲狀態 ── */
const $=id=>document.getElementById(id);
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const state={ game:null, mode:'idle', lifted:null, drawn:-1, resolve:null,
  claimOffer:null, turnSeat:-1, riverSeq:[], coachOn:true, autopilot:false,
  lastHandCount:0, animRiverLen:0, animDrawnFor:-1, dealtAt:0, review:[], rvIdx:0,
  cutRect:null, freshMeld:null, stake:{b:10,t:10}, me:null };

function toast(msg){ const t=$('uToast'); t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),1400); }
function callout(word,color,sub){
  const el=$('uCallout');
  $('uCoWord').textContent=word; $('uCoWord').style.color=color;
  $('uCoSub').textContent=sub||'';
  el.classList.remove('go'); void el.offsetWidth; el.classList.add('go');
}

/* 胡牌光芒爆發（三圈擴散＋放射火花） */
function burst(){
  if(state.autopilot) return;
  const el=$('uBurst');
  let h='<div class="ring"></div><div class="ring"></div><div class="ring"></div>';
  for(let i=0;i<14;i++){
    const a=(i/14)*Math.PI*2, d=90+Math.random()*70;
    h+=`<div class="spark" style="--dx:${(Math.cos(a)*d).toFixed(0)}px;--dy:${(Math.sin(a)*d).toFixed(0)}px;animation-delay:${(i*0.02).toFixed(2)}s"></div>`;
  }
  el.innerHTML=h;
  el.classList.remove('go'); void el.offsetWidth; el.classList.add('go');
}

/* 飛牌：從 srcRect 飛到牌河最新那張的位置 */
function flyTile(kind, srcRect){
  if(state.autopilot||!srcRect) return;
  const target=$('uRiver').querySelector('.tile:last-child');
  if(!target) return;
  const tr=target.getBoundingClientRect();
  const el=document.createElement('div');
  el.className='fly';
  el.style.cssText=`left:0;top:0;width:${srcRect.width}px;height:${srcRect.height}px;`
    +`transform:translate(${srcRect.left}px,${srcRect.top}px) scale(1);opacity:1;`;
  el.innerHTML=tileFaceSVG(kind);
  document.body.appendChild(el);
  target.classList.add('landing');
  requestAnimationFrame(()=>{
    const sc=tr.width/srcRect.width;
    el.style.transform=`translate(${tr.left}px,${tr.top}px) scale(${sc.toFixed(3)})`;
    el.style.transformOrigin='top left';
  });
  setTimeout(()=>{ el.remove(); target.classList.remove('landing'); }, 440);
}

/* 人類控制器：resolve 由 UI 點擊觸發 */
const human={
  async discard(view){
    state.mode='discard'; state.lifted=null; render();
    if(state.autopilot){ const c=rankDiscards(view.hand,view.meldCount,view.visible,view.table)[0];
      recordDecision(view,c.kind); state.mode='idle'; state.drawn=-1; return c.kind; }
    return new Promise(res=>{ state.resolve=k=>{ recordDecision(view,k); state.mode='idle'; state.drawn=-1; state.resolve=null; res(k); render(); }; });
  },
  async claim(view,offer){
    if(state.autopilot){
      if(offer.type==='win') return true;
      if(offer.type==='kong'){
        for(let i=0;i<offer.options.length;i++)
          if(evalKong(view.hand,view.meldCount,offer.options[i]).take) return i;
        return null;
      }
      if(offer.type==='pon'){
        if(offer.canKong&&evalKong(view.hand,view.meldCount,{mode:'minkan',tile:offer.tile}).take) return 'kong';
        return evalClaim(view.hand,view.meldCount,{type:'pon',tile:offer.tile}).take;
      }
      for(const b of offer.bases) if(evalClaim(view.hand,view.meldCount,{type:'chow',tile:offer.tile,base:b}).take) return b;
      return null;
    }
    state.mode='claim'; state.claimOffer=offer; render();
    return new Promise(res=>{ state.resolve=v=>{ state.mode='idle'; state.claimOffer=null; state.resolve=null; res(v); render(); }; });
  },
};
/* AI 加一點思考延遲，讓人跟得上 */
function slowAI(){ const base=aiController();
  return { async discard(v){ if(!state.autopilot) await sleep(500); return base.discard(v); },
           async claim(v,o){ if(!state.autopilot) await sleep(250); return base.claim(v,o); } }; }

/* ── 鳴牌建議：吃/碰/槓到底該不該？ ── */
function claimAdvice(off){
  if(!off||off.type==='win') return null;
  const g=state.game, me=g.seats[0], f=me.melds.length;
  const menqing = f===0;                                   // 目前還是門清
  const isDragon = k => k>=31;                             // 中發白
  const myWind = 27+(me.wind-1), roundWind = 27+(g.round-1);
  const valueTile = k => isDragon(k) || k===myWind || k===roundWind;
  const cost = menqing ? '，而且會失去門清（−1 台）' : '';

  if(off.type==='kong'){
    const rs=off.options.map((o,i)=>({i,o,r:evalKong(me.hand,f,o)}));
    const good=rs.find(x=>x.r.take);
    if(good) return { idx:good.i, take:true,
      text:`建議<b>${good.o.mode==='ankan'?'暗槓':'加槓'}</b>——槓完向聽維持 ${good.r.after} 向聽還能多補一張牌（暗槓不破門清）` };
    return { take:false, text:`建議<b>不要槓</b>——槓完向聽會變差（${rs[0].r.before}→${rs[0].r.after}），手牌變化也變少` };
  }

  if(off.type==='pon'){
    const r=evalClaim(me.hand,f,{type:'pon',tile:off.tile});
    if(r.take) return { take:true,
      text:`建議<b>碰</b>——碰完從 ${r.before} 向聽進步到 ${r.after} 向聽${valueTile(off.tile)?'，而且這是有台的牌':''}${cost}` };
    if(valueTile(off.tile)) return { take:true, soft:true,
      text:`可以碰——向聽不會變好（維持 ${r.before} 向聽），但 <b>${TILE_NAMES[off.tile]}</b> 有台，想做牌可以碰${cost}` };
    return { take:false,
      text:`建議<b>不要碰</b>——碰了向聽也不會變好（還是 ${r.before} 向聽）${cost}` };
  }

  // 吃
  const rs=off.bases.map(b=>({b,r:evalClaim(me.hand,f,{type:'chow',tile:off.tile,base:b})}));
  const good=rs.filter(x=>x.r.take).sort((a,b)=>a.r.after-b.r.after)[0];
  if(good) return { base:good.b, take:true,
    text:`建議<b>吃 ${[good.b,good.b+1,good.b+2].map(k=>TILE_NAMES[k]).join('')}</b>——吃完從 ${good.r.before} 向聽進步到 ${good.r.after} 向聽${cost}` };
  return { take:false,
    text:`建議<b>不用吃</b>——吃了向聽不會變好（還是 ${rs[0].r.before} 向聽），等於拆牌換一組面子${cost}` };
}

/* ── 渲染 ── */
const OPPO_LABEL=['你','下家','對家','上家'];
/* 放槍危險度（現物/筋/壁/字牌見數 × 對手威脅度） */
const RISKC={ '安全':'#7ee29b', '低':'#a5e88f', '中':'#ffb020', '高':'#ff6b6b' };
function riskOf(k){
  const v=state.game.viewFor(0);
  return dangerOf(k, v.table.seats, 0, v.visible, v.table.turnsPlayed);
}
const WINDCH=['東','南','西','北'];
function render(){
  const g=state.game; if(!g||!g.seats) return;
  // 牌牆數字：有變動就跳一下
  const wallN=g.remaining();
  const wEl=$('uWall');
  if(wEl.textContent!==String(wallN)){
    wEl.textContent=wallN;
    wEl.classList.remove('bump'); void wEl.offsetWidth; wEl.classList.add('bump');
  }
  // 輪到你：手牌區呼吸光
  document.querySelector('.hand-zone').classList.toggle('my-turn', state.mode==='discard');

  // 對手（座位 1,2,3）
  let oh='';
  for(const i of [2,1,3].sort()) {} // keep order 1,2,3 → 下/對/上
  for(let i=1;i<=3;i++){
    const s=g.seats[i];
    const cnt=s.hand.reduce((a,b)=>a+b,0);
    const freshOc=state.freshMeld&&state.freshMeld.seat===i&&(Date.now()-state.freshMeld.at)<600;
    const melds=s.melds.map((m,mi)=>{
      const lab=m.kind==='kong'?(m.concealed?'暗槓':'槓'):m.kind==='pung'?'碰':'吃';
      const isLast=mi===s.melds.length-1;
      return `<span class="oc-meld${freshOc&&isLast?' fresh':''}">${lab}${TILE_NAMES[m.base]}</span>`;
    }).join('');
    const fl=s.flowers.length?`<span class="oc-flower">花×${s.flowers.length}</span>`:'';
    const last=s.river.length?tileHTML(s.river[s.river.length-1],'t-mini'):'';
    const th=threatOf(s, Math.max(...g.seats.map(x=>x.river.length)));
    const thLv=th<0.3?'lo':th<0.55?'mid':'hi';
    const thTxt=th<0.3?'安全':th<0.55?'留意':'危險';
    oh+=`<div class="oc${state.turnSeat===i?' turn':''}">
      <div class="oc-top"><span class="seat-b">${WINDCH[i]}</span><span class="oc-name">${OPPO_LABEL[i]}</span>
        <span class="oc-threat ${thLv}" title="威脅度（副露/巡數/牌路推估）">${thTxt}</span></div>
      <div class="oc-bot">${melds}${fl}<span class="oc-cut"><small>打</small>${last}</span></div></div>`;
  }
  $('uOppo').innerHTML=oh;

  // 牌河（依打出順序；最新一張落河動畫，只播一次）
  const newDrop=state.animRiverLen!==state.riverSeq.length;
  if(newDrop) state.animRiverLen=state.riverSeq.length;
  $('uRiver').innerHTML=state.riverSeq.map((r,i)=>{
    const last=i===state.riverSeq.length-1;
    const cls=(last?' fresh':'')+(last&&newDrop?' drop':'');
    return tileHTML(r.tile,'t-sm'+cls).replace('class="tile ',`class="tile rs${r.seat} `);
  }).join('');
  const rg=$('uRiver'); rg.scrollTop=rg.scrollHeight;

  // 我的副露/花
  const me=g.seats[0];
  const freshMine=state.freshMeld&&state.freshMeld.seat===0&&(Date.now()-state.freshMeld.at)<600;
  $('uMelds').innerHTML=me.melds.map((m,mi)=>{
    const ks = m.kind==='kong' ? [m.base,m.base,m.base,m.base]
             : m.kind==='pung' ? [m.base,m.base,m.base]
             : [m.base,m.base+1,m.base+2];
    const isLast=mi===me.melds.length-1;
    return `<span class="mine-meld${m.kind==='kong'?' is-kong':''}${freshMine&&isLast?' fresh':''}">${ks.map(k=>tileHTML(k,'t-mini')).join('')}</span>`;
  }).join(' ');
  $('uFlowers').textContent=me.flowers.length?('花：'+me.flowers.map(f=>FLOWER_NAMES[f]).join('')):'';

  // 手牌（打牌模式含摸牌 = 17-3f 張；其餘為靜止）
  state.advice = state.mode==='claim' ? claimAdvice(state.claimOffer) : null;
  renderHand();
  renderWinPrompt();
  renderActions();
}

/* 可以胡了：秀出胡牌牌型與台數，讓玩家看懂再決定 */
function renderWinPrompt(){
  const el=$('uWinPrompt'), o=state.claimOffer;
  if(state.mode!=='claim'||!o||o.type!=='win'){ el.style.display='none'; return; }
  const me=state.game.seats[0];
  const hand=me.hand.slice();
  if(!o.selfDraw) hand[o.tile]++;               // 榮和：把那張加進來看牌型
  const ctx=state.game.ctxFor(me, !!o.selfDraw, o.selfDraw?null:o.tile);
  const sc=scoreWin(hand, me.melds, ctx);
  $('uWpTitle').textContent = o.selfDraw?'🎉 自摸！可以胡了':'🎉 可以胡了！（胡別人打的牌）';
  $('uWpTai').textContent = sc?`${sc.total} 台`:'';
  if(sc){
    let used=false;
    $('uWpHand').innerHTML = sc.melds.map(m=>{
      const k0=strToKind(m.t);
      const ks=m.kind==='pung'?[k0,k0,k0]:[k0,k0+1,k0+2];
      return `<span class="wp-meld">${ks.map(k=>{
        const mark=(!used&&k===o.tile)?(used=true,' wt'):'';
        return tileHTML(k,'t-mini'+mark);
      }).join('')}</span>`;
    }).join('')
    + `<span class="wp-meld">${[0,1].map(()=>{
        const pk=strToKind(sc.pair);
        const mark=(!used&&pk===o.tile)?(used=true,' wt'):'';
        return tileHTML(pk,'t-mini'+mark);
      }).join('')}</span>`;
    const names=sc.lines.length?sc.lines.map(l=>l.name+' '+l.tai).join('・'):'屁胡（無台）';
    $('uWpNote').innerHTML=`牌型：5 副面子 + 1 對將（金框＝胡的那張）　台：${names}`;
  } else { $('uWpHand').innerHTML=''; $('uWpNote').textContent=''; }
  el.style.display='';
}

function handList(){
  const me=state.game.seats[0], list=[];
  const counts=me.hand.slice();
  if(state.mode==='discard' && state.drawn>=0 && counts[state.drawn]>0) counts[state.drawn]--; // 摸的那張獨立顯示
  for(let k=0;k<KINDS;k++) for(let c=0;c<counts[k];c++) list.push(k);
  return list;
}
function renderHand(){
  const me=state.game.seats[0];
  const canCut=state.mode==='discard';
  // 教練建議：同向聽且進張並列最高的「全部」推薦，讓玩家自己選
  let recSet=new Set(), coachTxt='';
  if(canCut && state.coachOn){
    const rk=rankDiscards(me.hand, me.melds.length, state.game.visibleFor(0));
    if(rk.length){
      const bestS=rk[0].shanten;
      const group=rk.filter(o=>o.shanten===bestS);
      const maxU=group[0].ukeire;
      const coBest=group.filter(o=>o.ukeire===maxU);
      const others=group.filter(o=>o.ukeire<maxU).slice(0,2);
      coBest.forEach(o=>recSet.add(o.kind));
      const names=coBest.map(o=>`<b>${TILE_NAMES[o.kind]}</b>`).join(' 或 ');
      let stateTxt=bestS===-1?'就胡了':bestS===0?'聽牌':bestS+'向聽';
      if(bestS===0){
        me.hand[coBest[0].kind]--;
        const w=usefulTiles(me.hand, me.melds.length, state.game.visibleFor(0));
        me.hand[coBest[0].kind]++;
        stateTxt='聽牌，聽 '+w.tiles.map(t=>TILE_NAMES[t.kind]).slice(0,5).join('/');
      }
      coachTxt=`🧑‍🏫 建議打 ${names}　<span style="color:var(--txt-dim)">打完${stateTxt}、進張 ${maxU} 張</span>`;
      if(others.length) coachTxt+=`<span style="color:var(--txt-dim)">　次選：${others.map(o=>TILE_NAMES[o.kind]+'('+o.ukeire+'張)').join('、')}</span>`;
      // 防守教學：每張建議牌的放槍風險（含最安全的替代選擇）
      const riskTxt=coBest.map(o=>{ const lb=dangerLabel(riskOf(o.kind)); return `${TILE_NAMES[o.kind]} <b style="color:${RISKC[lb]}">${lb}</b>`; }).join('・');
      let extra='';
      const safest=[...rk].filter(o=>o.shanten<=bestS+1).map(o=>({o,d:riskOf(o.kind)})).sort((a,b)=>a.d-b.d)[0];
      if(safest && !recSet.has(safest.o.kind) && safest.d<0.15)
        extra=`　想保守可打 <b style="color:#7ee29b">${TILE_NAMES[safest.o.kind]}</b>（最安全）`;
      coachTxt+=`<br><span style="font-size:.72rem;color:var(--txt-dim)">放槍風險：${riskTxt}${extra}</span>`;
    }
  }
  const coach=$('uCoach');
  if(!state.coachOn){ coach.className='coach off'; coach.innerHTML='🧑‍🏫 教練已關閉（右上角可開）'; }
  else {
    coach.className='coach';
    const off=state.mode==='claim'?state.claimOffer:null;
    const t=off&&off.type;
    const adv=state.advice;
    coach.innerHTML= coachTxt || (
      t==='win' ? '🧑‍🏫 上面是你的胡牌牌型——看懂了再按「胡」，也可以先不胡繼續打'
    : adv ? `🧑‍🏫 ${adv.text}`
    : t ? '🧑‍🏫 有人打了牌——看下面按鈕決定要不要鳴' : '🧑‍🏫 等待中…');
  }

  // 摸牌位
  const dr=$('uDrawn');
  if(canCut && state.drawn>=0){
    const isRec=recSet.has(state.drawn);
    const doPop=state.animDrawnFor!==state.drawn; if(doPop) state.animDrawnFor=state.drawn;
    const lifted=state.lifted==='d';
    dr.innerHTML=`<small>剛摸 ▸</small><div class="cell${isRec?' rec':''}${lifted?' lift':''}${doPop?' pop':''}" data-key="d" data-k="${state.drawn}">
      ${isRec?'<div class="rec-tag">教練推薦</div>':''}${lifted?'<div class="cut-tag">再點一下打出 ▲</div>':''}${tileHTML(state.drawn)}</div>`;
  } else { dr.innerHTML=''; state.animDrawnFor=-1; }

  // 手牌格（同種牌只在第一張標「教練推薦」字樣；發光全都有；開局逐張滑入）
  const list=handList();
  const nowT=Date.now();
  if(state.lastHandCount===0&&list.length>0) state.dealtAt=nowT;
  state.lastHandCount=list.length;
  const dealAnim=nowT-state.dealtAt<900;
  const tagged=new Set();
  $('uHand').innerHTML=list.map((k,i)=>{
    const isRec=canCut&&recSet.has(k)&&!(state.drawn===k&&recSet.has(state.drawn));
    const showTag=isRec&&!tagged.has(k); if(showTag) tagged.add(k);
    const lifted=canCut&&state.lifted===('h'+i);   // 用位置判斷：同種牌不會一起彈
    const anim=dealAnim?` deal" style="animation-delay:${i*38}ms`:'';
    return `<div class="cell${isRec?' rec':''}${lifted?' lift':''}${anim}" data-key="h${i}" data-k="${k}">
      ${showTag?'<div class="rec-tag">教練推薦</div>':''}${lifted?'<div class="cut-tag">再點一下打出 ▲</div>':''}${tileHTML(k)}</div>`;
  }).join('');
  $('uHint').textContent=canCut?'點一下選牌，再點同一張打出':'';
}

function renderActions(){
  const a=$('uActions');
  if(state.mode!=='claim'||!state.claimOffer){ a.innerHTML=''; return; }
  const o=state.claimOffer;
  const adv=state.advice, coachOn=state.coachOn;
  // 教練推薦的那顆按鈕加金框
  const mark=(kind,val)=>{
    if(!coachOn||!adv) return '';
    if(kind==='pass') return adv.take===false?' best':'';
    if(!adv.take) return '';
    if(kind==='chow') return adv.base===val?' best':'';
    if(kind==='kong') return adv.idx===val?' best':'';
    return ' best';
  };
  let h='';
  if(o.type==='win') h=`<button class="act hu" data-a="win" style="animation-delay:0s">${o.selfDraw?'自摸胡！':'胡！'}</button><button class="act pass" data-a="pass" style="animation-delay:.08s">先不胡</button>`;
  else if(o.type==='kong'){
    h=o.options.map((op,i)=>{
      const tiles=Array.from({length:4},(_,j)=>tileHTML(op.tile,'t-sm'+(j===3?' claimed':''))).join('');
      const lab=op.mode==='ankan'?'暗槓':'加槓';
      return `<button class="act kong tiles${mark('kong',i)}" data-a="kong" data-i="${i}" style="animation-delay:${i*.08}s"><span class="act-lab">${lab}</span>${tiles}</button>`;
    }).join('')+`<button class="act pass${mark('pass')}" data-a="pass" style="animation-delay:${o.options.length*.08}s">不槓</button>`;
  }
  else if(o.type==='pon'){
    const tiles=[o.tile,o.tile,o.tile].map((k,i)=>tileHTML(k,'t-sm'+(i===2?' claimed':''))).join('');
    h=`<button class="act pon tiles${mark('pon')}" data-a="pon" style="animation-delay:0s"><span class="act-lab">碰</span>${tiles}</button>`;
    if(o.canKong){
      const kt=Array.from({length:4},(_,j)=>tileHTML(o.tile,'t-sm'+(j===3?' claimed':''))).join('');
      h+=`<button class="act kong tiles" data-a="minkan" style="animation-delay:.08s"><span class="act-lab">槓</span>${kt}</button>`;
    }
    h+=`<button class="act pass${mark('pass')}" data-a="pass" style="animation-delay:${o.canKong?.16:.08}s">跳過</button>`;
  }
  else if(o.type==='chow'){
    h=o.bases.map((b,i)=>{
      const tiles=[b,b+1,b+2].map(k=>tileHTML(k,'t-sm'+(k===o.tile?' claimed':''))).join('');
      return `<button class="act chow tiles${mark('chow',b)}" data-a="chow" data-b="${b}" style="animation-delay:${i*.08}s"><span class="act-lab">吃</span>${tiles}</button>`;
    }).join('')
     +`<button class="act pass${mark('pass')}" data-a="pass" style="animation-delay:${o.bases.length*.08}s">跳過</button>`;
  }
  a.innerHTML=h;
}

/* ── 事件接線 ── */
$('uHand').addEventListener('click',handTap);
$('uDrawn').addEventListener('click',handTap);
function handTap(e){
  if(state.mode!=='discard') return;
  const cell=e.target.closest('.cell'); if(!cell) return;
  const key=cell.dataset.key, k=+cell.dataset.k;
  if(state.lifted===key){                     // 點「同一張」＝打出（比位置，不是比牌種）
    const t=cell.querySelector('.tile');
    state.cutRect = t ? t.getBoundingClientRect() : null;   // 記住起飛座標
    if(state.resolve) state.resolve(k);
    return;
  }
  state.lifted=key; // 點別張＝換選
  renderHand();
}
$('uActions').addEventListener('click',e=>{
  const b=e.target.closest('.act'); if(!b||!state.resolve) return;
  const act=b.dataset.a;
  if(act==='win') state.resolve(true);
  else if(act==='pon') state.resolve(true);
  else if(act==='minkan') state.resolve('kong');
  else if(act==='kong') state.resolve(+b.dataset.i);
  else if(act==='chow') state.resolve(+b.dataset.b);
  else state.resolve((state.claimOffer.type==='chow'||state.claimOffer.type==='kong')?null:false);
});
$('uCoachOn').addEventListener('change',e=>{ state.coachOn=e.target.checked; render(); });
$('uOverScore').addEventListener('click',e=>{
  const tr=e.target.closest('tr'); if(!tr||tr.dataset.groups===undefined) return;
  document.querySelectorAll('.win-meld').forEach(el=>el.classList.remove('hl'));
  (tr.dataset.groups||'').split(',').filter(x=>x!=='').forEach(gi=>{
    const el=document.querySelector(`.win-meld[data-g="${gi}"]`); if(el) el.classList.add('hl'); });
  if(tr.dataset.pair==='1'){ const p=document.querySelector('.win-meld[data-g="pair"]'); if(p) p.classList.add('hl'); }
});

/* ── 覆盤：記錄你每一手的決策 ── */
function recordDecision(view,chosen){
  const rk=rankDiscards(view.hand, view.meldCount, view.visible, view.table);
  const dg=k=>dangerOf(k, view.table.seats, 0, view.visible, view.table.turnsPlayed);
  const best=rk[0], mine=rk.find(o=>o.kind===chosen)||null;
  state.review.push({
    hand: view.hand.slice(), chosen, bestKind: best.kind,
    bestS: best.shanten, bestU: best.ukeire,
    mineS: mine?mine.shanten:null, mineU: mine?mine.ukeire:null,
    dangerChosen: dg(chosen),
    top: rk.slice(0,4).map(o=>({kind:o.kind, shanten:o.shanten, ukeire:o.ukeire, danger:dg(o.kind)})),
  });
}

function renderReview(){
  const R=state.review, i=state.rvIdx;
  if(!R.length){ $('uRvIdx').textContent='這局你沒有出手紀錄'; $('uRvHand').innerHTML=''; $('uRvRows').innerHTML=''; $('uRvVerdict').className='rv-verdict'; $('uRvVerdict').textContent=''; return; }
  const d=R[i];
  $('uRvIdx').textContent=`第 ${i+1} 手 / 共 ${R.length} 手`;
  $('uRvPrev').disabled=i===0; $('uRvNext').disabled=i===R.length-1;
  const optimal = d.chosen===d.bestKind || (d.mineS===d.bestS && d.mineU===d.bestU);
  const v=$('uRvVerdict');
  v.className='rv-verdict '+(optimal?'good':'warn');
  v.innerHTML = optimal
    ? `✅ 好球！你打 <b>${TILE_NAMES[d.chosen]}</b>　${d.bestS===0?'保持聽牌':d.bestS+' 向聽'}、進張 ${d.bestU} 張`
    : `⚠️ 有更好的：你打 <b>${TILE_NAMES[d.chosen]}</b>（${d.mineS!=null?d.mineS+'向聽/進張'+d.mineU:'—'}）　教練會打 <b>${TILE_NAMES[d.bestKind]}</b>（${d.bestS}向聽/進張${d.bestU}）`;
  const list=[]; for(let k=0;k<KINDS;k++) for(let c=0;c<d.hand[k];c++) list.push(k);
  let markedPlayed=false, markedBest=false;
  $('uRvHand').innerHTML=list.map(k=>{
    let cls='t-sm';
    if(k===d.chosen&&!markedPlayed){ cls+=' played'; markedPlayed=true; }
    else if(k===d.bestKind&&!markedBest){ cls+=' best'; markedBest=true; }
    return tileHTML(k,cls);
  }).join('');
  $('uRvRows').innerHTML=d.top.map((o,n)=>{
    const lb=dangerLabel(o.danger);
    const tag=o.kind===d.chosen?'（你打的）':n===0?'（最佳）':'';
    return `<div class="rv-row">${tileHTML(o.kind,'t-mini')}<b>${TILE_NAMES[o.kind]}</b>${tag}
      <span class="rv-m">${o.shanten===0?'聽牌':o.shanten+'向聽'}・進張${o.ukeire}・風險<span style="color:${RISKC[lb]}">${lb}</span></span></div>`;
  }).join('');
}

/* ── 成績上傳（訪客照玩，只是不記錄）＋ 排行榜 ── */
function coachAccuracy(){
  const R=state.review;
  if(!R.length) return {match:0,total:0,pct:null};
  const match=R.filter(d=>d.chosen===d.bestKind||(d.mineS===d.bestS&&d.mineU===d.bestU)).length;
  return { match, total:R.length, pct:Math.round(match/R.length*1000)/10 };
}
const VERDICT={
  'skill-win':{t:'技術有底子，這回牌運也站你這邊',
    d:'但別忘了：這是<b>打 AI</b>。真人牌桌有情緒、有默契、有你看不到的變數，而且長期還有抽水在磨你。<b>打牌怡情就好，別把它當提款機。</b>'},
  'skill-lose':{t:'你打得不錯——但還是輸了',
    d:'這就是麻將：<b>技術好也擋不住牌運</b>。而這正是真實牌桌上最危險的情況——你會覺得「只是運氣不好」，然後一直加碼想凹回來。<b>會這樣想的人，就是輸最多的人。</b>'},
  'luck-win':{t:'你贏了，但打法有問題',
    d:'這是<b>最危險的一種贏</b>：贏錢會讓你以為自己會打，於是敢賭更大。等牌運回歸平均，前面贏的會全部吐回去、還倒賠。<b>先把技術補起來再說。</b>'},
  'both-bad':{t:'技術和牌運都還沒站在你這邊',
    d:'老實說：<b>你現在去跟人賭錢，大概率是輸的那個</b>。先在這裡練到一致率 70% 以上，再考慮上真牌桌——而且就算練起來了，也建議只玩輸得起的金額。'},
};
function renderReport(rep, stake){
  if(!rep||!rep.ready) return rep&&rep.need>0
    ? `<div class="rpt-note">📊 打滿 ${rep.need+rep.games} 局會給你「技術／戰績」雙軌評級（還差 ${rep.need} 局）</div>` : '';
  const v=VERDICT[rep.verdict], mul=100/stake.b;
  const netReal=Math.round(Math.abs(rep.net)*mul);
  return `<div class="rpt">
    <div class="rpt-grid">
      <div class="rpt-card"><small>技術評級</small><div class="rpt-g ${rep.skill}">${rep.skill}</div>
        <small>教練一致率 ${rep.accuracy}%</small></div>
      <div class="rpt-card"><small>戰績</small>
        <div class="rpt-net ${rep.net>=0?'up':'down'}">${rep.net>=0?'+':''}${rep.net}</div>
        <small>${rep.games} 局累計（點）</small></div>
    </div>
    <div class="rpt-say"><b>${v.t}</b><br>${v.d}</div>
    <div class="rpt-note">※ 換算成 <b>100 元一台</b>的真實牌局，你這 ${rep.games} 局${rep.net>=0?'贏':'輸'}了約 <b>NT$${netReal}</b>。<br>
      ※ 麻將短期運氣佔比很高，15 局只是參考——但<b>真實牌桌不會等你打滿 15 局才收你錢</b>。</div>
  </div>`;
}

async function submitResult(res){
  const acc=coachAccuracy();
  const iWon = res.type==='win' && res.winner===0;
  const tai = res.score ? res.score.total : 0;   // 我輸時＝付給贏家的台數
  const outcome = res.type==='draw' ? 'draw' : (iWon ? 'win' : 'lose');
  const selfDraw = res.type==='win' && !!res.selfDraw;
  const dealtIn = res.type==='win' && !iWon && res.from===0;   // 我放槍
  const st=state.stake;
  const box=$('uAccBox');
  const local = acc.total
    ? `本局跟教練一致 <span class="acc-n">${acc.pct}%</span> <small>（${acc.match}/${acc.total} 手）</small>`
    : '本局你沒有出手紀錄';
  box.innerHTML=local;
  if(!acc.total) return;
  try{
    const r=await fetch('/api/mahjong/result',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({ outcome, selfDraw, dealtIn, tai, base:st.b, taiVal:st.t,
        coachMatch:acc.match, coachTotal:acc.total })}).then(x=>x.json());
    if(r.ok){
      const s=r.stats, pct=s.coach_total?Math.round(s.coach_match/s.coach_total*1000)/10:0;
      let h=local;
      if(r.delta!==0){
        const real=Math.round(Math.abs(r.delta)*(100/st.b));
        h+=`<br><span class="acc-n" style="color:${r.delta>0?'#7ee29b':'#ff6b6b'}">${r.delta>0?'+':''}${r.delta} 點</span>`
         + `<small>　剩 ${r.points} 點</small>`
         + `<div class="money-warn">💸 這局你${r.delta>0?'贏了':(dealtIn?'放槍付了':'付了')} <b>${Math.abs(r.delta)} 點</b>。
              如果這是真的 <b>100 元一台</b>的牌局，就是 <b>NT$${real}</b> 進出你的口袋。</div>`;
      } else h+=`<br><small>本局沒有輸贏（流局／別人胡別人）</small>`;
      h+=`<br><small>累計 ${s.games} 局・胡 ${s.wins} 次・一致率 ${pct}%・淨 ${s.net_points>=0?'+':''}${s.net_points} 點</small>`;
      h+=renderReport(r.report, st);
      box.innerHTML=h;
    } else if(r.error==='guest'){
      box.innerHTML=local+`<br><small>訪客不記錄成績、也不計輸贏——登入就能用 1000 點當籌碼，測出自己的真實牌技</small><br><a class="acc-cta" href="/member/">免費登入開始測 →</a>`;
    }
  }catch(e){ /* 離線也不影響遊戲 */ }
}
async function showBoard(){
  $('uBoard').style.display='flex';
  const body=$('uBoardBody'); body.textContent='載入中…';
  try{
    const j=await fetch('/api/mahjong/leaderboard',{cache:'no-store'}).then(r=>r.json());
    const rows=(j.leaderboard||[]).map(r=>
      `<div class="bd-row${j.me&&j.me.nickname===r.nickname?' mine':''}"><span class="bd-rank">${r.rank}</span>
        <span class="bd-name">${String(r.nickname||'鄉民').replace(/[<>&]/g,'')}</span>
        <span class="bd-acc">${r.accuracy}%</span>
        <span class="bd-sub">${r.games}局・${r.bestTai}台</span></div>`).join('');
    let mine='';
    if(!j.me) mine=`<div class="bd-empty">你還沒登入——訪客可以照玩，<br><a class="acc-cta" href="/member/">登入後成績才會記錄上榜 →</a></div>`;
    else if(j.me.needGames>0) mine=`<div class="bd-empty">你目前 ${j.me.games} 局、一致率 ${j.me.accuracy}%<br>再打 <b>${j.me.needGames}</b> 局就會出現在榜上</div>`;
    body.innerHTML=(rows||`<div class="bd-empty">還沒有人上榜，快去打第一局！</div>`)+mine;
  }catch(e){ body.innerHTML='<div class="bd-empty">排行榜載入失敗</div>'; }
}
$('uBoardBtn').addEventListener('click',e=>{ e.preventDefault(); $('uOver').style.display='none'; showBoard(); });
$('uBoardClose').addEventListener('click',()=>{ $('uBoard').style.display='none'; $('uOver').style.display='flex'; });

$('uReviewBtn').addEventListener('click',()=>{
  state.rvIdx=0; renderReview();
  $('uOver').style.display='none';       // 先收起結算面板，避免疊在覆盤上面
  $('uReview').style.display='flex';
});
$('uRvClose').addEventListener('click',()=>{
  $('uReview').style.display='none';
  $('uOver').style.display='flex';       // 關閉覆盤 → 回到結算面板
});
$('uRvPrev').addEventListener('click',()=>{ if(state.rvIdx>0){ state.rvIdx--; renderReview(); } });
$('uRvNext').addEventListener('click',()=>{ if(state.rvIdx<state.review.length-1){ state.rvIdx++; renderReview(); } });

/* ── 對局生命週期 ── */
function onEvent(e){
  if(e.t==='draw'){ state.turnSeat=e.seat; if(e.seat===0) state.drawn=e.tile; }

  if(e.t==='discard'){
    state.riverSeq.push({seat:e.seat,tile:e.tile});
    // 起飛座標：自己＝剛點的那張牌；對手＝他的資訊卡中心
    let src=state.cutRect;
    if(e.seat!==0){
      const card=$('uOppo').children[e.seat-1];
      if(card){ const r=card.getBoundingClientRect();
        src={ left:r.left+r.width/2-13, top:r.bottom-18, width:26, height:35 }; }
    }
    render();
    flyTile(e.tile, src);
    state.cutRect=null;
    return;
  }

  if(e.t==='pon'||e.t==='chow'||e.t==='kong'){
    if(e.t!=='kong'||e.mode==='minkan'){
      for(let i=state.riverSeq.length-1;i>=0;i--){ if(state.riverSeq[i].tile===e.tile){ state.riverSeq.splice(i,1); break; } }
      state.animRiverLen=state.riverSeq.length;
    }
    state.turnSeat=e.seat;
    state.freshMeld={ seat:e.seat, at:Date.now() };
    const who=e.seat===0?'你':OPPO_LABEL[e.seat];
    if(e.t==='pon') callout('碰！','#4ade80',who);
    else if(e.t==='chow') callout('吃！','#7db8ff',who);
    else callout('槓！','#c9a2f5', who+(e.mode==='ankan'?'（暗槓）':e.mode==='kakan'?'（加槓）':'（明槓）'));
  }

  if(e.t==='win') burst();
  if(e.t==='flower'&&e.seat===0) toast('補花：'+FLOWER_NAMES[e.flower]);
  render();
}

async function startGame(seed){
  state.riverSeq=[]; state.drawn=-1; state.mode='idle'; state.turnSeat=0;
  state.lastHandCount=0; state.animRiverLen=0; state.animDrawnFor=-1;
  state.review=[]; state.rvIdx=0; state.cutRect=null; state.freshMeld=null;
  $('uStart').style.display='none'; $('uOver').style.display='none';
  $('uReview').style.display='none'; $('uBoard').style.display='none';
  const g=new Game({ seed: seed ?? (Math.random()*1e9)|0,
    controllers:[human,slowAI(),slowAI(),slowAI()], onEvent });
  state.game=g;
  window.G8M.game=g;
  try{
    const res=await g.play();
    showResult(res);
    return res;
  }catch(err){ console.error(err); toast('發生錯誤：'+err.message); throw err; }
}

function showResult(res){
  state.mode='over'; render();
  const ov=$('uOver');
  let delay=0;
  if(res.type==='draw'){
    callout('流 局','#b9c4bb'); delay=900;
    $('uOverTitle').textContent='🌊 流局';
    $('uOverSub').textContent='牌牆摸完、沒人胡牌。休息一下再開！';
    $('uOverScore').innerHTML=''; $('uOverHand').innerHTML=''; $('uOverHint').textContent='';
  } else {
    const who=res.winner===0?'你':OPPO_LABEL[res.winner];
    callout(res.selfDraw?'自 摸！':'胡！','#ffd24a',who); delay=1000;
    $('uOverTitle').textContent = res.winner===0?'🎉 你胡了！':`${who} 胡了`;
    $('uOverSub').textContent = (res.selfDraw?'自摸':'胡 '+(res.from===0?'你':OPPO_LABEL[res.from])+' 打的牌');
    const sc=res.score;
    // 胡牌牌型（圖示）：5 組面子 + 將
    if(sc){
      $('uOverHand').innerHTML = sc.melds.map((m,gi)=>{
        const k0=strToKind(m.t);
        const ks=m.kind==='pung'?[k0,k0,k0]:[k0,k0+1,k0+2];
        return `<span class="win-meld" data-g="${gi}">${ks.map(k=>tileHTML(k,'t-sm')).join('')}${m.exposed?'<i class="wm-tag">明</i>':''}</span>`;
      }).join('')
      +`<span class="win-meld" data-g="pair">${tileHTML(strToKind(sc.pair),'t-sm')}${tileHTML(strToKind(sc.pair),'t-sm')}<i class="wm-tag j">將</i></span>`;
    } else $('uOverHand').innerHTML='';
    if(sc && sc.lines.length){
      $('uOverScore').innerHTML =
        sc.lines.map((l,i)=>`<tr class="srow" data-groups="${l.groups.join(',')}" data-pair="${l.pairRef?1:0}" style="animation-delay:${.15+i*.12}s"><td>${l.name}</td><td>${l.tai} 台</td></tr>`).join('')
        +`<tr class="tt srow" style="animation-delay:${.15+sc.lines.length*.12}s"><td>合計</td><td>${sc.total} 台</td></tr>`;
      $('uOverHint').textContent='👆 點台種名稱，上面會亮出對應的牌';
    } else {
      $('uOverScore').innerHTML='<tr class="tt srow"><td>屁胡（無台）</td><td>0 台</td></tr>';
      $('uOverHint').textContent='';
    }
  }
  submitResult(res);
  setTimeout(()=>{ ov.style.display='flex'; }, state.autopilot?0:delay);
}

/* 底台選擇 ＋ 目前點數 */
$('uStakeRow').addEventListener('click',e=>{
  const b=e.target.closest('.sp'); if(!b) return;
  $('uStakeRow').querySelectorAll('.sp').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');
  state.stake={ b:+b.dataset.b, t:+b.dataset.t };
  refreshPts();
});
function refreshPts(){
  const st=state.stake, el=$('uPts');
  if(!state.me){ el.innerHTML='🎮 <b>訪客模式</b>：可以照玩，但不計輸贏、不記錄成績　<a class="acc-cta" href="/member/" style="margin-top:.4rem">免費登入用 1000 點測牌技 →</a>'; return; }
  const unit=st.b+2*st.t; // 以 2 台估一局
  el.innerHTML=`🪙 你有 <b>${state.me.points}</b> 點　<small>（這個底台，一局大約 ${unit}~${st.b+8*st.t} 點進出；輸光隔天自動補滿）</small>`;
}
fetch('/api/me').then(r=>r.json()).then(j=>{ state.me=j.member||null; refreshPts(); }).catch(()=>refreshPts());

$('uStartBtn').addEventListener('click',()=>startGame());
$('uAgainBtn').addEventListener('click',()=>startGame());

/* 測試掛鉤：autopilot 全自動打完一局 */
window.G8M={ state, startGame, game:null, render,
  async autoTest(seed){ state.autopilot=true; try{ const r=await startGame(seed??42); return {type:r.type,winner:r.winner,total:r.score?r.score.total:null}; } finally{ state.autopilot=false; } } };
</script>
</body>
</html>
