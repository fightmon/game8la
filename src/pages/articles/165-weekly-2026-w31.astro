---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ManifestoBox from '../../components/ManifestoBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';

const weekLabel = '2026 第 31 週（7/23–7/29）';
const publishDate = '2026-08-17';

/* ── 娛樂城／博弈類（本週：老面孔換皮，娛樂城安靜） ── */
const casinoBrands = [
  { name: '新葡京娛樂城', url: 'k75992.com', count: 1, badge: '換皮', note: '165 黑名單的常勝軍又換殼了——這週新域名 k75992.com。「新葡京」這集團累計逾 200 件通報、幾十個 m.bycp…、k…、m.k… 系列即棄網域，一被檢舉就換一個繼續騙。看到「新葡京」但網址是隨機英數的 k/m 開頭域名，直接跳過。' },
];

/* ── 假投資平台（本週財務詐騙大宗，取通報量前段） ── */
const investScams = [
  { name: 'decRED（假虛擬貨幣）', url: 'deccred.com', count: 8 },
  { name: 'TimeeCoin（假虛擬貨幣）', url: 'sybjk.com', count: 7 },
  { name: 'Prime Traffic', url: 'www.promargin-point.store', count: 6 },
  { name: 'Datahydrux AI（AI 量化）', url: 'datahydrulmk.com', count: 6 },
  { name: 'D.V.E', url: 'www.dvepiw.com', count: 6 },
  { name: 'DERIVATIVES', url: 'www.adavdeaba.com', count: 6 },
  { name: '臺灣證券交易所（冒名官方）', url: 'puxuntw.com', count: 2 },
];

/* ── 殺豬盤（假交友 → 假投資） ── */
const romanceScams = [
  { name: 'Flirting', url: 'ws.tugsvs.top', count: 6 },
  { name: 'SEXA', url: 'talmerionva.com', count: 5 },
  { name: 'Dating', url: 'bp.bachellor.cc', count: 3 },
  { name: '心遇', url: 'asy.psby118.club', count: 1 },
  { name: 'Dreamy Club', url: 'w1.rwyszm.cc', count: 1 },
];
---

<ArticleSchema
  url="https://game8la.com/articles/165-weekly-2026-w31/"
  title={`【165 週報】${weekLabel}：假購物 KFC 領銜、冒名臺灣證交所現身`}
  description={`內政部警政署 165 全民防騙網 ${weekLabel} 詐騙通報週報。本週假購物（KFC 16 件）通報量最高；假投資分散（decRED 8 件最高）；還冒出蹭「臺灣證券交易所」官方名號的假投資站。娛樂城安靜，只有老面孔新葡京換新域名回榜。165 共列逾 120 個詐騙網站，GAME8LA 165 監測站每週追蹤。`}
  image="https://game8la.com/images/articles/165-weekly-default-cover.webp"
  datePublished={publishDate}
  dateModified={publishDate}
  breadcrumbs={[
    { name: '首頁', url: 'https://game8la.com/' },
    { name: '芭樂攻略', url: 'https://game8la.com/articles/' },
    { name: '165 週報', url: 'https://game8la.com/articles/165-weekly-2026-w31/' },
  ]}
/>
<BaseLayout
  currentPage="articles"
  title={`【165 週報】${weekLabel}：假購物 KFC 領銜、冒名臺灣證交所現身｜GAME8LA 165 監測站`}
  description={`165 全民防騙網 ${weekLabel} 通報彙整：假購物 KFC 領銜、假投資分散、冒名臺灣證券交易所現身，娛樂城老面孔新葡京換皮回榜。芭樂子每週追蹤整理，保護你的錢包。`}
>
  <div class="container">
    <div class="breadcrumb"><a href="/">首頁</a> &gt; <a href="/articles/">芭樂攻略</a> &gt; 165 週報</div>
    <div style="color:var(--text-muted);font-size:0.8rem;margin-bottom:0.5rem">
      <Icon name="clock" /> 發佈日：{publishDate} ｜
      <Icon name="user-pen" /> 作者：芭樂子｜
      <Icon name="book-open" /> 預估閱讀 4 分鐘 ｜
      <span style="color:#f5b800;font-weight:700">🔍 165 監測站週報</span>
    </div>
    <a href="/articles/" class="back-link"><Icon name="arrow-left" /> 回攻略列表</a>
    <div class="hero-banner" style="background:linear-gradient(135deg,#0a0a1a,#1a1a3a,#ef4444)"></div>

    <article class="article-content" style="max-width:820px;margin:0 auto">
      <h1 style="font-size:1.8rem;line-height:1.3">🔍 165 監測站週報｜{weekLabel}<br /><em>假購物 KFC 領銜，冒名臺灣證交所現身</em></h1>

      <p style="color:var(--text-muted);font-size:0.95rem">各位 8LA 鄉民好，我是芭樂子。每週我會從<strong>內政部警政署 165 全民防騙網</strong>的最新通報中，挑出跟<strong>娛樂城、博弈、假投資、殺豬盤</strong>這類「會把你錢騙光」的財務詐騙整理成週報。目的很簡單——<strong>讓你在入金、匯款之前，多一道防線</strong>。（冒用品牌的假購物詐騙不是本站專長，僅在文末帶過。）</p>

      <!-- === 本週摘要 === -->
      <div class="card" style="border-left:4px solid #ef4444;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#ef4444">⚠️ 本週摘要</h3>
        <p style="margin:0">165 本週（7/23–7/29）公布逾 <strong>120 筆</strong>「假投資（博弈）」詐騙通報，通報量前三為 <strong>KFC</strong>（冒用品牌假購物）16 件、<strong>TikTok</strong>（冒用品牌假購物）9 件、<strong>decRED</strong>（假虛擬貨幣）8 件。本週<strong>假購物竄居榜首</strong>；<strong>假投資分散、無單一巨頭</strong>（decRED 8 件最高）；殺豬盤持穩（Flirting 6）。娛樂城類本週非常安靜，只有老面孔 <strong>新葡京</strong>又換新域名回榜。另外冒出蹭官方名號的 <strong>「臺灣證券交易所」</strong>假投資站，值得警惕。</p>
      </div>

      <!-- === 165 總覽 === -->
      <div class="card" style="border-left:4px solid #44aaff;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#44aaff">📈 本週 165 通報總覽</h3>
        <p>本週「假投資（博弈）」類公告共列出逾 <strong>120 個</strong>詐騙網站，通報量前段：</p>
        <ul style="margin:0.5rem 0;line-height:2">
          <li><strong>KFC</strong>（冒用品牌假購物）— 16 件</li>
          <li><strong>TikTok</strong>（冒用品牌假購物）— 9 件</li>
          <li><strong>decRED</strong>（假虛擬貨幣）— 8 件</li>
          <li><strong>TimeeCoin</strong>（假虛擬貨幣）— 7 件</li>
        </ul>
        <p style="margin-bottom:0">類型分布上，本週<strong>冒用品牌假購物</strong>（KFC、TikTok）通報量最高；<strong>假投資平台</strong>（假幣、AI 量化、冒名券商）仍是財務詐騙主流但分散；殺豬盤持穩。娛樂城／博弈品牌通報量極低，但這不代表變少——它們多半轉往社群、廣告、LINE 群這些更難被通報的管道。</p>
      </div>

      <!-- === 娛樂城／博弈 === -->
      <h2 id="casino" style="color:#ef4444">🎰 娛樂城／博弈：本週安靜，老面孔換皮</h2>
      <p>本週娛樂城類通報非常少，唯一上榜的是「換皮之王」<strong>新葡京</strong>——它完美示範了詐騙娛樂城的本質：換域名比換衣服還勤。</p>
      <div class="weekly-brand-list">
        {casinoBrands.map(brand => (
          <div class="weekly-brand-card new-brand">
            <div class="brand-header">
              <span class="brand-badge updated">🔁 換皮</span>
              <strong>{brand.name}</strong>
              <span class="brand-count">{brand.count} 件</span>
            </div>
            <div class="brand-url">🌐 <code>{brand.url}</code></div>
            <p class="brand-note">💡 {brand.note}</p>
          </div>
        ))}
      </div>

      <!-- === 假投資 === -->
      <h2 id="invest" style="color:#f5b800">💰 假投資平台（本週大宗、但分散）</h2>
      <p>假投資仍是財務詐騙主流——假虛擬貨幣、AI 智能量化、冒名券商，話術千變萬化，但結局都一樣：<strong>初期讓你看到帳面獲利，等你加碼，提領時就「不出金」</strong>。本週沒有壓倒性的單一巨頭，通報量前段：</p>
      <div class="scam-table-wrap">
        <table class="scam-table">
          <thead><tr><th>品牌</th><th>網址</th><th>件數</th></tr></thead>
          <tbody>
            {investScams.map(s => (
              <tr><td>{s.name}</td><td><code>{s.url}</code></td><td class="ct">{s.count}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- === 殺豬盤 === -->
      <h2 id="romance" style="color:#ec4899">💔 殺豬盤：先談感情，再騙你投資</h2>
      <p>本週殺豬盤持穩，套路不變：<strong>先用「正妹／帥哥」假交友養感情</strong>，幾天後再「不小心」透露自己有內線投資管道，把你導去假平台或假博弈。本週上榜的假交友幌子：</p>
      <div class="scam-table-wrap">
        <table class="scam-table">
          <thead><tr><th>品牌</th><th>網址</th><th>件數</th></tr></thead>
          <tbody>
            {romanceScams.map(s => (
              <tr><td>{s.name}</td><td><code>{s.url}</code></td><td class="ct">{s.count}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- === 趨勢觀察 === -->
      <h2 id="trend">📊 本週趨勢觀察</h2>
      <div class="card" style="border-left:4px solid #f5b800;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#f5b800">芭樂子觀察筆記</h3>
        <p><strong>1. 連「臺灣證券交易所」都敢冒名</strong>——本週假投資冒出 <code>puxuntw.com</code> 掛「臺灣證券交易所」的名號。記住：<strong>臺灣證券交易所是市場管理機構，不經營投資平台、不會叫你入金、更不會私訊帶你操作</strong>。任何用官方金融機構名號＋陌生域名叫你入金的，100% 是詐騙。</p>
        <p><strong>2. 假投資 ＝ 不出金娛樂城的雙胞胎</strong>——decRED、TimeeCoin、Datahydrux AI 這些假投資平台，跟詐騙娛樂城是同一套：帳面假獲利 → 誘你加碼 → 提領時各種理由拖延凍結。手法一模一樣，只是一個包成「投資」、一個包成「博弈」。看懂一個，就看得懂另一個。</p>
        <p style="margin-bottom:0"><strong>3. 娛樂城看域名紀錄，不看名字</strong>——這週新葡京又冒新殼 k75992.com。這集團是累犯，證明詐騙娛樂城根本不在乎「品牌信譽」，賺一票就換域名跑。<strong>判斷該不該信，要查網域與紀錄，不是看名字。</strong>還有這週一堆 <code>.store</code>、<code>.cc</code>、<code>.top</code>、<code>.club</code> 的怪域名——正規平台不會用這種便宜即丟的頂級域名。</p>
      </div>

      <!-- === CTA === -->
      <div class="casino-check-cta" style="background:linear-gradient(135deg,#0a1a2e,#1a2a4a);border:2px solid #f5b800;border-radius:12px;padding:2rem;text-align:center;margin:2rem 0">
        <h3 style="color:#f5b800;margin-top:0;font-size:1.3rem">🔍 擔心你玩的娛樂城／平台在黑名單上？</h3>
        <p style="color:#ccc;margin-bottom:1.2rem">把網址丟進「娛樂城體檢」，一秒比對 165 詐騙黑名單 + WHOIS 網域年齡 + 鄉民不出金回報</p>
        <a href="/casino-check/" class="cta-button" style="display:inline-block;background:#f5b800;color:#000;padding:0.8rem 2rem;border-radius:8px;font-weight:700;text-decoration:none;font-size:1.1rem">立即查詢 →</a>
      </div>

      <!-- === 其他類別 === -->
      <div class="card" style="border-left:4px solid #888;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#aaa">📦 其他類別：冒用品牌假購物</h3>
        <p style="margin:0">本週假購物通報量最高，另有 <strong>KFC（16 件）、TikTok（9 件）、Delmira shop、SHEIN、Coupang、Amazon、iOPEN Mall、Galaxus</strong> 等冒用知名品牌的假購物網站。這類非本站專長，僅提醒大家：<strong>看到「知名品牌但網址很怪」（如 kfcmgk.com、tikmallfjl.top）的超低價購物連結，請直接跳過。</strong>完整名單見下方 165 官方公告。</p>
      </div>

      <!-- === 資料來源 === -->
      <div style="margin-top:2rem;padding:1rem;background:rgba(255,255,255,0.05);border-radius:8px;font-size:0.85rem;color:var(--text-muted)">
        <p style="margin:0"><strong>📋 資料來源</strong>：<a href="https://165.npa.gov.tw/#/article/9/1827" target="_blank" rel="noopener noreferrer">內政部警政署 165 全民防騙網 — 115/7/23-115/7/29 民眾通報假投資(博弈)詐騙網站</a></p>
        <p style="margin:0.5rem 0 0">本站聚焦娛樂城／博弈／假投資／殺豬盤等財務詐騙通報，並加上芭樂子的手法解析；完整名單請以 165 官方公告為準。整理發布時間：{publishDate}</p>
      </div>

      <!-- === 延伸閱讀 === -->
      <h2>📚 延伸閱讀</h2>
      <ul style="line-height:2">
        <li><a href="/casino-check/">🔍 娛樂城體檢工具 — 一鍵查 165 黑名單 + WHOIS + 鄉民回報</a></li>
        <li><a href="/articles/165-weekly-2026-w29/">🔍 前期週報：2026 第 29 週（7/9–7/15）</a></li>
        <li><a href="/articles/domain-hopping-scam-truth/">🔗 娛樂城網址一直換？金蟬脫殼詐騙真相</a></li>
        <li><a href="/articles/5-tips-spot-casino-scam/">🛡️ 5 招識破娛樂城詐騙套路</a></li>
        <li><a href="/articles/anti-scam-8la-guide/">🐊 芭樂子反詐總攻略</a></li>
      </ul>

      <ShareButtons />
      <ManifestoBox />
    </article>
  </div>
</BaseLayout>

<style>
  .weekly-brand-list { display: flex; flex-direction: column; gap: 1rem; margin: 1rem 0; }
  .weekly-brand-card { background: rgba(255,255,255,0.04); border-radius: 10px; padding: 1.2rem; border-left: 4px solid; }
  .weekly-brand-card.new-brand { border-left-color: #ef4444; }
  .brand-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; font-size: 1.1rem; flex-wrap: wrap; }
  .brand-badge { font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 700; white-space: nowrap; }
  .brand-badge.updated { background: rgba(245,184,0,0.2); color: #f5b800; }
  .brand-count { margin-left: auto; font-size: 0.8rem; color: var(--text-muted); }
  .brand-url { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.4rem; }
  .brand-url code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85rem; color: #ff9999; }
  .brand-note { font-size: 0.85rem; color: var(--text-muted); margin: 0; line-height: 1.6; }

  .scam-table-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; }
  .scam-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .scam-table th { text-align: left; color: var(--text-muted); font-weight: 600; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--border); font-size: 0.82rem; }
  .scam-table td { padding: 0.55rem 0.7rem; border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; }
  .scam-table td code { background: rgba(255,255,255,0.08); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.8rem; color: #ff9999; word-break: break-all; }
  .scam-table td.ct { text-align: center; font-weight: 800; color: #ef4444; white-space: nowrap; }

  @media (max-width: 768px) {
    .weekly-brand-card { padding: 1rem; }
    .brand-header { font-size: 1rem; }
    .scam-table { font-size: 0.84rem; }
  }
</style>
