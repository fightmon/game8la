    .th-cards.small .pc{ width:35px; height:49px; }
    .th-cards.small .pc-tl{ font-size:.74rem; }
  }
  @media (prefers-reduced-motion: reduce){ *{ animation:none!important; transition:none!important; } }
</style>
</BaseLayout>
