    .th-cards.small .pc-br{ display:none; }          /* 更小的牌：只留左上角索引，避免對角壓到 */
    .th-cards.small .pc-tl{ font-size:.82rem; top:6px; left:6px; }
    .th-cards.small .pc-tl i{ font-size:.78rem; }
