];

/* ── 假投資平台（本週財務詐騙大宗，取通報量前段） ── */
const investScams = [
  { name: 'TimeeCoin（假虛擬貨幣）', url: 'lmonx.com', count: 10 },
  { name: '中國金融期貨交易所（冒名）', url: 'zzgjrqh…ondigitalocean.app', count: 7 },
  { name: '策聯優選', url: 'www.lweuzc.com', count: 6 },
  { name: 'DWTMarkets', url: 'www.dwtyeovnspg.com', count: 5 },
  { name: 'Chun Feng（QuanYong 系列）', url: 'www.quanyong-forex.com', count: 5 },
  { name: '效能管理系統', url: 'netzeroav.com', count: 5 },
  { name: 'BitFinex（冒名交易所）', url: 'fxaxtc.com', count: 4 },
  { name: 'J.Q.X', url: 'www.jqxzhi.com', count: 3 },
];

/* ── 殺豬盤（假交友 → 假投資） ── */
const romanceScams = [
  { name: 'Flirting', url: 'es.tdgbgf.cc', count: 3 },
  { name: '心遇', url: 'h5.psby168.xyz', count: 2 },
  { name: 'Masked Sex', url: 'er.sgsvsd.cc', count: 1 },
  { name: 'Dating', url: 'bp.bache1or.com', count: 1 },
  { name: 'Meet your zone', url: 'ws.gjabhsb.cc', count: 1 },
