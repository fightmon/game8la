const weekLabel = '2026 第 29 週（7/9–7/15）';
const publishDate = '2026-07-19';

/* ── 娛樂城／博弈類（本週：換皮＋新殼站＋假彩券） ── */
const casinoBrands = [
  { name: 'RK娛樂城', url: 'm.rk678.vip', count: 1, badge: '換皮', note: '一週一換的活教材：上週（W25）通報的還是 rk588.com，這週就換成 m.rk678.vip。同一個「RK」招牌、換個即棄網域繼續騙。看到「RK娛樂城」但網址每次都不一樣的，核心永遠是同一票人、同一套不出金。' },
