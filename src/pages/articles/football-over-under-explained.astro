---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ManifestoBox from '../../components/ManifestoBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';

const faqs = [
  { q: '大小分（大小球）是什麼意思？', a: '大小分是運彩最常見的玩法之一，賭的不是「誰贏」，而是<strong>兩隊加起來總共進幾球</strong>。莊家開一條線（例如 2.5 球），你只要猜<strong>實際總進球會「超過」這條線（買「大」）還是「低於」這條線（買「小」）</strong>。例：盤口 2.5，終場 2:1（共 3 球）＞2.5 → 買大過關；終場 1:0（共 1 球）＜2.5 → 買小過關。完全不管哪隊贏。' },
  { q: '大小分的盤口為什麼常常是 2.5？', a: '足球一場平均大約 2.5～2.8 球，所以 2.5 是最經典的中間線——買大買小機會差不多、賠率都壓在 1.9 上下，盤口才平衡。<strong>有 .5 還有一個好處：不可能走盤</strong>。因為 0.5 球不存在，總進球一定不是「超過」就是「低於」2.5，沒有打平退錢這回事。盤口越高（3.5、4.5）代表莊家越看好進球多。' },
  { q: '大小分怎麼結算？會走盤嗎？', a: '把兩隊總進球加起來，跟盤口線比大小就好：<strong>總進球 ＞ 盤口 → 大分過關；＜ 盤口 → 小分過關</strong>。<strong>關鍵在盤口是 .5 還是整數</strong>：盤口 2.5 這種半數，一定分出大小、不會走盤；但盤口若是<strong>整數（例如 3）</strong>，終場剛好進 3 球＝跟線打平，就<strong>走盤、退回本金</strong>，不賠不賺。' },
  { q: '大小分和讓分盤有什麼不一樣？', a: '兩個問的問題完全不同。<strong>讓分盤</strong>關心「<strong>誰贏、贏多少</strong>」（兩隊的差距）；<strong>大小分</strong>只關心「<strong>兩隊加起來進幾球</strong>」（總數），<strong>完全不管誰贏</strong>。所以你可以同時「看好弱隊受讓」又「看好這場是小分（很悶）」，兩個盤各押各的、互不衝突。想搞懂讓分，看芭樂子的讓分盤專文。' },
  { q: '2.25、2.75 這種「半大半小」是什麼？', a: '這是<strong>四分之一盤</strong>，跟讓分的 0.25／0.75 一樣的玩法——把你的注金<strong>自動拆成兩半</strong>。例如買大 2.75 ＝ 一半當「大 2.5」、一半當「大 3」。如果終場剛好 3 球：大 2.5 那半贏、大 3 那半走盤 → 結算「<strong>贏一半</strong>」。所以四分盤會出現全贏／贏一半／走盤／輸一半／全輸。不想自己拆？用本文的計算器選 2.75 直接幫你算。' },
  { q: '看大小分有什麼簡單的判斷方向嗎？', a: '芭樂子提醒：這是教你「看懂」不是「報明牌」。常識方向是——兩支進攻火力猛的隊對轟，容易開大；兩支龜縮的鐵桶陣互卡，容易開小；淘汰賽通常比小組賽悶（不想先丟球）。但這些都只是傾向，足球一顆定生死，沒有穩贏。<strong>真要練手就用世足8LA的免費點數玩，輸光也不心疼</strong>，真錢只碰合法運彩、別碰境外黑網。' },
];

const URL = 'https://game8la.com/articles/football-over-under-explained/';
---
<FaqSchema faqs={faqs} />
<ArticleSchema
  url={URL}
  title="大小分是什麼？進球數怎麼算大小一次搞懂（附動畫示範＋結算計算器）— GAME8LA"
  description="大小分（大小球）賭的不是誰贏，是兩隊總進球超過或低於盤口（例 2.5）。芭樂子白話＋開踢動畫示範＋結算計算器：大小怎麼算、2.5 為何不走盤、2.25／2.75 半大半小怎麼拆，一看就懂。"
  image="https://game8la.com/images/articles/football-overunder-cover.webp"
  datePublished="2026-06-15"
  dateModified="2026-06-15"
  breadcrumbs={[
    { name: '首頁', url: 'https://game8la.com/' },
    { name: '足球教室', url: 'https://game8la.com/articles/' },
    { name: '大小分是什麼', url: URL },
  ]}
/>
<BaseLayout currentPage="articles" title="大小分是什麼？進球數怎麼算大小一次搞懂（附動畫示範＋結算計算器）— GAME8LA" description="大小分（大小球）賭的不是誰贏，是兩隊總進球超過或低於盤口（例 2.5）。芭樂子白話＋開踢動畫示範＋結算計算器：大小怎麼算、2.5 為何不走盤、2.25／2.75 半大半小怎麼拆，一看就懂。" ogImage="https://game8la.com/images/articles/football-overunder-cover.webp">
  <div class="container">
    <div class="breadcrumb"><a href="/">首頁</a> &gt; <a href="/articles/">足球教室</a> &gt; 大小分是什麼</div>
    <div style="color:var(--text-muted);font-size:0.95rem;margin-bottom:0.5rem">
      <Icon name="clock" /> 發佈日：2026-06-15 ｜
      <Icon name="user-pen" /> 作者：芭樂子 ｜
      <Icon name="book-open" /> 預估閱讀 9 分鐘
    </div>
    <a href="/articles/" class="back-link"><Icon name="arrow-left" /> 回攻略列表</a>
    <div class="hero-banner" style="background:linear-gradient(135deg,#1a472a,#2d8a4e,#f5b800)"></div>

    <article class="article-content" style="max-width:820px;margin:0 auto">

      <h1 style="font-size:2rem;line-height:1.3">大小分是什麼？<em>芭樂子白話講進球數怎麼算大小，附開踢動畫＋結算計算器</em></h1>

      <img class="content-img"
           src="/images/articles/football-overunder-cover.webp"
           srcset="/images/articles/football-overunder-cover-768w.webp 768w, /images/articles/football-overunder-cover.webp 1200w"
           sizes="(max-width: 880px) 100vw, 820px"
           alt="大小分是什麼｜芭樂子化身運彩老師，比著進球計分板講解大小球｜GAME8LA"
           width="1200" height="670" loading="eager" fetchpriority="high" decoding="async" />
      <p class="article-img-caption">看球聽人喊「這場買大」一頭霧水？芭樂子用開踢動畫，讓你一眼看懂大小分。</p>

      <div class="quick-tool-bar">
        <span>看球必備：</span>
        <a href="#demo">大小分動畫示範</a>
        <a href="/articles/football-handicap-explained/">讓分盤是什麼</a>
        <a href="/worldcup/">世足8LA專區</a>
      </div>

      <p style="color:var(--text-muted);font-size:0.95rem">8LA 鄉民好，我是芭樂子。看世足時旁邊一定有人冒出一句「<strong>這場我買大</strong>」，你問他買大是買哪一隊，他會露出「你不懂喔」的表情——其實他自己也快講不清楚。大小分根本<strong>不管哪一隊</strong>，賭的是「<strong>兩隊加起來進幾球</strong>」。這篇芭樂子用一個<strong>會動的開踢示範</strong>讓你秒懂，再附一個<strong>結算計算器</strong>，輸入比數就告訴你大小過不過關。</p>

      <!-- === 目錄 === -->
      <div class="toc" style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1.2rem 1.5rem;margin:1.5rem 0">
        <h2 style="font-size:1.2rem;margin-top:0">本文快速導覽</h2>
        <ol>
          <li><a href="#s1">大小分用一句話解釋</a></li>
          <li><a href="#demo">🎬 動畫示範：按下開踢看大小</a></li>
          <li><a href="#s3">大小分怎麼結算（會不會走盤）</a></li>
          <li><a href="#calc">🧮 大小分結算計算器</a></li>
          <li><a href="#s5">2.25／2.75 半大半小怎麼拆</a></li>
          <li><a href="#s6">大小分 vs 讓分盤：別搞混</a></li>
          <li><a href="#faq">常見問題 FAQ</a></li>
        </ol>
      </div>

      <h2 id="s1" style="margin-top:2.5rem">大小分用一句話解釋</h2>

      <p>芭樂子先給你一句話版本，背起來就夠用了：</p>

      <div class="card" style="margin:1.2rem 0 1.5rem;border-color:var(--guava-green);background:linear-gradient(135deg,rgba(57,255,20,0.06) 0%,rgba(30,30,30,0.5) 100%)">
        <h3 style="color:var(--guava-green);margin-top:0;font-size:1.1rem">一句話版大小分</h3>
        <p style="font-size:1.05rem;line-height:1.9"><strong>莊家開一條線（例如 2.5 球），你只猜「兩隊加起來的總進球」會超過它（買「大」）還是低於它（買「小」）——完全不管誰贏。</strong></p>
      </div>

      <p>用生活比喻：<strong>就像賭「今天會下幾場雨」。</strong>氣象局說標準線是 2.5 場，你不用管是哪個區下的、誰先下，你只賭「全天加起來」超過還是不到 2.5 場。足球大小分一模一樣——不管主隊客隊、誰進的，<strong>只看終場兩隊進球加總的那個數字</strong>。</p>

      <!-- === 動畫示範器 === -->
      <h2 id="demo" style="margin-top:2.5rem">🎬 動畫示範：按下開踢，看大小怎麼跑出來</h2>
      <p>文字看再多不如看它動一次。按「<strong>開踢模擬</strong>」，球會一顆顆進、總進球往上加、標記滑過盤口線，最後亮出大分還是小分。多按幾次，每場結果都不一樣：</p>

      <div class="ou-demo" id="ouDemo">
        <div class="ou-demo-top">
          <div class="ou-score" id="ouScore">🏠 主 0 : 0 客</div>
          <div class="ou-bigtotal"><span class="ou-bt-num" id="ouTotal">0</span><span class="ou-bt-label">總進球</span></div>
        </div>
        <svg class="ou-svg" id="ouSvg" viewBox="0 0 700 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="大小分動畫示範：總進球與盤口線">
          <!-- track -->
          <line x1="60" y1="95" x2="600" y2="95" stroke="#555" stroke-width="3"/>
          <!-- ticks 0..6 -->
          <g id="ouTicks"></g>
          <!-- 盤口線 -->
          <line id="ouLine" x1="285" y1="40" x2="285" y2="120" stroke="#f5b800" stroke-width="3" stroke-dasharray="7,5"/>
          <text id="ouLineLabel" x="285" y="32" text-anchor="middle" fill="#f5b800" font-size="16" font-weight="800">盤口 2.5</text>
          <!-- zones labels -->
          <text x="160" y="138" text-anchor="middle" fill="#5b8def" font-size="14" font-weight="700">← 小分 UNDER</text>
          <text x="470" y="138" text-anchor="middle" fill="#39FF14" font-size="14" font-weight="700">大分 OVER →</text>
          <!-- marker -->
          <g id="ouMarker" style="transform:translateX(0px);transition:transform .45s ease">
            <circle cx="60" cy="95" r="13" fill="#fff" stroke="#222" stroke-width="2"/>
            <circle cx="60" cy="95" r="5" fill="#222"/>
          </g>
        </svg>
        <div class="ou-verdict" id="ouVerdict">按「開踢模擬」開始 👇</div>
        <div class="ou-controls">
          <label class="ou-linesel">盤口
            <select id="ouLineSel">
              <option value="1.5">大小 1.5</option>
              <option value="2.5" selected>大小 2.5</option>
              <option value="3.5">大小 3.5</option>
            </select>
          </label>
          <button type="button" class="ou-play" id="ouPlay">▶ 開踢模擬</button>
        </div>
      </div>

      <p>看懂了嗎？<strong>球一直進、標記一直往右跑，只要越過那條金色盤口線，就是「大分」；停在線左邊就是「小分」。</strong>哪一隊進的根本不重要——大小分的世界裡，只有「總共幾球」這件事。</p>

      <h2 id="s3" style="margin-top:2.5rem">大小分怎麼結算（會不會走盤）</h2>

      <p>結算超簡單，一句話：<strong>把兩隊總進球加起來，跟盤口比大小。</strong></p>

      <div class="card" style="margin:1.5rem 0;border-color:#f5b800;background:linear-gradient(135deg,rgba(245,184,0,0.08) 0%,rgba(30,30,30,0.5) 100%)">
        <h3 style="color:#f5b800;margin-top:0">結算規則</h3>
        <table>
          <thead><tr><th>情況</th><th>結果</th></tr></thead>
          <tbody>
            <tr><td>總進球 <strong>＞</strong> 盤口</td><td style="color:#39FF14;font-weight:700">買「大」過關</td></tr>
            <tr><td>總進球 <strong>＜</strong> 盤口</td><td style="color:#5b8def;font-weight:700">買「小」過關</td></tr>
            <tr><td>總進球 <strong>＝</strong> 盤口（限整數盤）</td><td style="color:#bbb;font-weight:700">走盤，退回本金</td></tr>
          </tbody>
        </table>
        <p style="margin:0.8rem 0 0;font-size:0.95rem;color:var(--text-muted)">記住眉角：<strong>盤口有 .5（2.5／3.5）→ 一定分大小、不會走盤</strong>；盤口是<strong>整數（3）→ 剛好進 3 球就走盤退錢</strong>。</p>
      </div>

      <p>舉例最快懂：</p>
      <div class="card" style="margin:1.5rem 0;border-color:#4caf50;background:linear-gradient(135deg,rgba(76,175,80,0.06) 0%,rgba(30,30,30,0.5) 100%)">
        <p style="margin:.3rem 0"><strong style="color:#39FF14">盤口 2.5，終場 3:1（共 4 球）</strong>：4 ＞ 2.5 → <strong>買大過關</strong>。</p>
        <p style="margin:.3rem 0"><strong style="color:#5b8def">盤口 2.5，終場 1:0（共 1 球）</strong>：1 ＜ 2.5 → <strong>買小過關</strong>。</p>
        <p style="margin:.3rem 0"><strong style="color:#bbb">盤口 3，終場 2:1（共 3 球）</strong>：3 ＝ 3 → <strong>走盤退錢</strong>。</p>
      </div>

      <!-- === 計算器 === -->
      <h2 id="calc" style="margin-top:2.5rem">🧮 大小分結算計算器</h2>
      <p>輸入終場比數和盤口，芭樂子幫你算出<strong>買大</strong>和<strong>買小</strong>各自過不過關——連 2.25／2.75 的「贏一半／輸一半」都算給你看。</p>

      <div class="ou-calc" id="ouCalc">
        <div class="ou-row">
          <div class="ou-field">
            <label for="ouHome">主隊進球</label>
            <input type="number" id="ouHome" min="0" max="20" step="1" value="2" inputmode="numeric">
          </div>
          <div class="ou-vs">:</div>
          <div class="ou-field">
            <label for="ouAway">客隊進球</label>
            <input type="number" id="ouAway" min="0" max="20" step="1" value="1" inputmode="numeric">
          </div>
        </div>
        <div class="ou-field ou-linef">
          <label for="ouHcp">盤口（大小幾球）</label>
          <select id="ouHcp">
            <option value="1.5">1.5</option>
            <option value="2">2（整數）</option>
            <option value="2.25">2.25（半大半小）</option>
            <option value="2.5" selected>2.5</option>
            <option value="2.75">2.75（半大半小）</option>
            <option value="3">3（整數）</option>
            <option value="3.25">3.25</option>
            <option value="3.5">3.5</option>
            <option value="4.5">4.5</option>
          </select>
        </div>
        <button type="button" class="ou-btn" id="ouGo">算給我看 →</button>

        <div class="ou-result" id="ouResult" hidden>
          <div class="ou-headline" id="ouHeadline"></div>
          <div class="ou-cards">
            <div class="ou-card" id="ouCardBig">
              <div class="ou-card-title">買「大 OVER」</div>
              <div class="ou-card-verdict" id="ouBigV"></div>
            </div>
            <div class="ou-card" id="ouCardSmall">
              <div class="ou-card-title">買「小 UNDER」</div>
              <div class="ou-card-verdict" id="ouSmallV"></div>
            </div>
          </div>
          <p class="ou-comment" id="ouComment"></p>
        </div>
      </div>

      <h2 id="s5" style="margin-top:2.5rem">2.25／2.75 半大半小怎麼拆</h2>

      <p>盤口除了 2.5 這種半數，有時會看到 <strong>2.25、2.75</strong> 這種「<strong>四分之一盤</strong>」（跟讓分的 0.25／0.75 一樣的機制）。它會把你的注金<strong>自動拆成兩半</strong>：</p>

      <div class="card" style="margin:1.5rem 0;border-color:#2196f3;background:linear-gradient(135deg,rgba(33,150,243,0.06) 0%,rgba(30,30,30,0.5) 100%)">
        <h3 style="color:#2196f3;margin-top:0">四分盤怎麼拆</h3>
        <ul style="margin:0">
          <li><strong>大小 2.25</strong> ＝ 一半當「大小 2」、一半當「大小 2.5」。</li>
          <li><strong>大小 2.75</strong> ＝ 一半當「大小 2.5」、一半當「大小 3」。</li>
          <li>於是會出現<strong>「贏一半」</strong>（一半注贏、一半走盤退錢）或<strong>「輸一半」</strong>（一半注輸、一半退錢）。</li>
        </ul>
        <p style="margin:0.8rem 0 0;font-size:0.95rem;color:var(--text-muted)">例：買大 2.75、終場剛好進 3 球 → 大 2.5 那半贏、大 3 那半走盤 → 結算<strong>「贏一半」</strong>。懶得拆?上面計算器選 2.75 直接算。</p>
      </div>

      <h2 id="s6" style="margin-top:2.5rem">大小分 vs 讓分盤：一句話別搞混</h2>

      <div class="card" style="margin:1.5rem 0;border-color:#cd212a;background:linear-gradient(135deg,rgba(205,33,42,0.07) 0%,rgba(30,30,30,0.5) 100%)">
        <h3 style="color:#ff5252;margin-top:0">兩種盤，問的問題不一樣</h3>
        <p><strong style="color:#ff5252">讓分盤</strong>問：「<strong>誰贏、贏多少</strong>」——關心兩隊的<strong>差距</strong>。</p>
        <p style="margin-bottom:0"><strong style="color:#ff5252">大小分</strong>問：「<strong>加起來進幾球</strong>」——只看<strong>總數</strong>，不管誰贏。</p>
      </div>

      <p>所以你可以同時「看好弱隊受讓」又「看好這場開小（很悶）」，兩個盤各押各的、互不衝突。想把讓分盤也一次搞懂，看芭樂子的 <a href="/articles/football-handicap-explained/" style="color:var(--guava-green)">讓分盤是什麼（附結算計算器）</a>，跟這篇剛好成對。</p>

      <!-- === FAQ === -->
      <h2 id="faq" style="margin-top:2.5rem">常見問題 FAQ</h2>
      <div class="faq-section">
        {faqs.map(faq => (
          <details class="faq-item">
            <summary class="faq-q">{faq.q}</summary>
            <div class="faq-a" set:html={faq.a} />
          </details>
        ))}
      </div>

      <!-- === 免責聲明 === -->
      <div style="margin:2rem 0;padding:1rem 1.2rem;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:10px;font-size:0.95rem;color:var(--text-muted)">
