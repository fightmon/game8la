  <!-- 大小分動畫示範 -->
  <script is:inline>
    (function () {
      var demo = document.getElementById('ouDemo');
      if (!demo) return;
      var X0 = 60, STEP = 90;
      var svg = document.getElementById('ouSvg'),
          ticks = document.getElementById('ouTicks'),
          lineEl = document.getElementById('ouLine'),
          lineLabel = document.getElementById('ouLineLabel'),
          marker = document.getElementById('ouMarker'),
          scoreEl = document.getElementById('ouScore'),
          totalEl = document.getElementById('ouTotal'),
          verdictEl = document.getElementById('ouVerdict'),
          lineSel = document.getElementById('ouLineSel'),
          playBtn = document.getElementById('ouPlay');
      var SVGNS = 'http://www.w3.org/2000/svg';
      // draw ticks 0..6
      for (var n = 0; n <= 6; n++) {
        var x = X0 + n * STEP;
        var t = document.createElementNS(SVGNS, 'text');
        t.setAttribute('x', x); t.setAttribute('y', 118);
        t.setAttribute('text-anchor', 'middle'); t.setAttribute('fill', '#888'); t.setAttribute('font-size', '14');
        t.textContent = n;
        ticks.appendChild(t);
        var tick = document.createElementNS(SVGNS, 'line');
        tick.setAttribute('x1', x); tick.setAttribute('y1', 90); tick.setAttribute('x2', x); tick.setAttribute('y2', 100);
        tick.setAttribute('stroke', '#555'); tick.setAttribute('stroke-width', '2');
        ticks.appendChild(tick);
      }
      var timer = null;
      function setLine() {
        var line = parseFloat(lineSel.value);
        var lx = X0 + line * STEP;
        lineEl.setAttribute('x1', lx); lineEl.setAttribute('x2', lx);
        lineLabel.setAttribute('x', lx); lineLabel.textContent = '盤口 ' + line;
      }
      function moveMarker(n) { marker.style.transform = 'translateX(' + (n * STEP) + 'px)'; }
      function reset() {
        if (timer) { clearTimeout(timer); timer = null; }
        scoreEl.textContent = '🏠 主 0 : 0 客';
        totalEl.textContent = '0';
        moveMarker(0);
        verdictEl.className = 'ou-verdict';
        verdictEl.textContent = '開踢…⚽';
      }
      function pickGoals() {
        // 偏向 1~3 球的真實分布
        var pool = [0, 1, 1, 2, 2, 2, 3, 3, 4, 5];
        return pool[Math.floor(Math.random() * pool.length)];
      }
      function play() {
        reset();
        playBtn.disabled = true;
        var line = parseFloat(lineSel.value);
        var goals = pickGoals();
        var home = 0, away = 0, i = 0;
        function step() {
          if (i < goals) {
            if (Math.random() < 0.5) home++; else away++;
            scoreEl.textContent = '🏠 主 ' + home + ' : ' + away + ' 客 ⚽';
            totalEl.textContent = (i + 1);
            moveMarker(i + 1);
            i++;
            timer = setTimeout(step, 780);
          } else {
            var over = goals > line;
            if (over) {
              verdictEl.className = 'ou-verdict ou-over';
              verdictEl.textContent = '⚽ 大分 OVER！總進球 ' + goals + '（超過 ' + line + '）';
            } else {
              verdictEl.className = 'ou-verdict ou-under';
              verdictEl.textContent = '🥱 小分 UNDER！總進球 ' + goals + '（沒到 ' + line + '）';
            }
            playBtn.disabled = false;
            playBtn.textContent = '🔄 再踢一場';
            timer = null;
          }
        }
        if (goals === 0) {
          // 0:0 直接結算
          timer = setTimeout(step, 500);
        } else {
          timer = setTimeout(step, 400);
        }
      }
      setLine();
      lineSel.addEventListener('change', function () { setLine(); reset(); verdictEl.textContent = '按「開踢模擬」開始 👇'; verdictEl.className = 'ou-verdict'; });
      playBtn.addEventListener('click', play);
    })();
  </script>

  <!-- 大小分結算計算器 -->
  <script is:inline>
    (function () {
      var root = document.getElementById('ouCalc');
      if (!root) return;
      var $h = document.getElementById('ouHome'), $a = document.getElementById('ouAway'),
          $l = document.getElementById('ouHcp'), $go = document.getElementById('ouGo'),
          $res = document.getElementById('ouResult'), $head = document.getElementById('ouHeadline'),
          $bigV = document.getElementById('ouBigV'), $smallV = document.getElementById('ouSmallV'),
          $cBig = document.getElementById('ouCardBig'), $cSmall = document.getElementById('ouCardSmall'),
          $comment = document.getElementById('ouComment');

      function single(total, line) {
        var e = total - line;
        if (e > 1e-9) return 'win';
        if (e < -1e-9) return 'lose';
        return 'push';
      }
      // 買「大」在盤口 L 的結果（支援四分盤）
      function bigResult(total, L) {
        var isQuarter = Math.abs((L * 100) % 50) > 1e-6;
        if (!isQuarter) return single(total, L);
        var m = { win: 1, push: 0, lose: -1 };
        var s = m[single(total, L - 0.25)] + m[single(total, L + 0.25)];
        if (s === 2) return 'win';
        if (s === 1) return 'halfwin';
        if (s === 0) return 'push';
        if (s === -1) return 'halflose';
        return 'lose';
      }
      function invert(r) { return { win: 'lose', lose: 'win', halfwin: 'halflose', halflose: 'halfwin', push: 'push' }[r]; }
      var LABEL = {
        win: { t: '✅ 全贏', cls: 'win' },
        halfwin: { t: '🟢 贏一半', cls: 'win' },
        push: { t: '⚪ 走盤（退本金）', cls: 'push' },
        halflose: { t: '🟠 輸一半', cls: 'lose' },
        lose: { t: '❌ 全輸', cls: 'lose' }
      };
      function fmt(n) { return (Math.round(n * 100) / 100).toString(); }

      function run() {
        var h = parseInt($h.value, 10), a = parseInt($a.value, 10), L = parseFloat($l.value);
        if (isNaN(h) || h < 0) h = 0;
        if (isNaN(a) || a < 0) a = 0;
        var total = h + a;
        var rBig = bigResult(total, L), rSmall = invert(rBig);
        $head.textContent = '終場 ' + h + ' : ' + a + '，總進球 ' + total + '　vs　盤口 ' + fmt(L);
        var lb = LABEL[rBig]; $bigV.textContent = lb.t; $cBig.className = 'ou-card ' + lb.cls;
        var ls = LABEL[rSmall]; $smallV.textContent = ls.t; $cSmall.className = 'ou-card ' + ls.cls;
        var c;
        if (rBig === 'push') c = '總進球剛好等於盤口（整數盤）→ 大小都走盤、退回本金，不賠不賺。';
        else if (rBig === 'halfwin' || rBig === 'halflose') c = '這是四分盤的眉角：不是非贏即輸，還有贏一半／輸一半。';
        else if (rBig === 'win') c = '總進球 ' + total + ' 超過盤口 ' + fmt(L) + '，買大的爽領、買小的捶心肝。';
        else c = '總進球 ' + total + ' 沒到盤口 ' + fmt(L) + '，買小的穩穩過、買大的空等一場。';
        $comment.textContent = '芭樂子：' + c;
        $res.hidden = false;
      }
      $go.addEventListener('click', run);
      [$h, $a].forEach(function (el) { el.addEventListener('keydown', function (e) { if (e.key === 'Enter') run(); }); });
      $l.addEventListener('change', function () { if (!$res.hidden) run(); });
    })();
  </script>

