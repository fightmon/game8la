  { name: 'RK娛樂城', url: 'www.rk588.com', count: 1, badge: '新上榜', note: '同樣本週新上榜、單一域名的殼站。這類「三碼英文＋數字」的娛樂城名，賺一票就換殼跑，沒有任何信譽可言。' },
];

/* ── 假投資平台（本週財務詐騙大宗，取通報量前段） ── */
const investScams = [
  { name: '大河智贏', url: '071f171tu.1vpbia9fl.com', count: 23 },
  { name: 'TimeeCoin（假虛擬貨幣）', url: 'gzshhs.com', count: 9 },
  { name: 'XT（冒名交易所）', url: 'www.xt-2wz9qr.top', count: 8 },
  { name: 'FIDU', url: 'fiduclow.com', count: 7 },
  { name: '聚瑞播', url: 'www.scntmocc.com', count: 7 },
  { name: 'D.V.E', url: 'www.dvefjp.com', count: 6 },
  { name: 'Macro market（冒名中信證券）', url: 'www.citics7168.com', count: 5 },
  { name: 'QuanYong', url: 'www.quanyong-trade.com', count: 5 },
];

/* ── 殺豬盤（假交友 → 假投資） ── */
const romanceScams = [
  { name: 'Flirting', url: 'qt.knftr6fyhxe40.cc', count: 12 },
  { name: 'Deep Love club', url: 'qt.bbdshhfsdf.cc', count: 6 },
  { name: 'One Night', url: 'night520.love', count: 2 },
  { name: 'wonderfullovess', url: 'www.wonderfullovess.vip', count: 2 },
  { name: '緣愛俱樂部', url: 'like888.top', count: 1 },
  { name: '心跳俱樂部', url: 'heartstorem.com', count: 1 },
];
---

<ArticleSchema
  url="https://game8la.com/articles/165-weekly-2026-w25/"
  title={`【165 週報】${weekLabel}：大河智贏假投資空降榜首、殺豬盤持續高檔`}
  description={`內政部警政署 165 全民防騙網 ${weekLabel} 詐騙通報週報。假投資「大河智贏」以 23 件空降本週榜首；殺豬盤 Flirting 通報 12 件持續高檔；娛樂城類老面孔（新葡京、必發）換新域名回榜。165 共列逾 150 個詐騙網站，GAME8LA 165 監測站每週追蹤。`}
  image="https://game8la.com/images/articles/165-weekly-default-cover.webp"
  datePublished={publishDate}
  dateModified={publishDate}
  breadcrumbs={[
    { name: '首頁', url: 'https://game8la.com/' },
    { name: '芭樂攻略', url: 'https://game8la.com/articles/' },
    { name: '165 週報', url: 'https://game8la.com/articles/165-weekly-2026-w25/' },
  ]}
/>
<BaseLayout
  currentPage="articles"
  title={`【165 週報】${weekLabel}：大河智贏假投資空降榜首｜GAME8LA 165 監測站`}
  description={`165 全民防騙網 ${weekLabel} 通報彙整：假投資「大河智贏」23 件空降榜首，殺豬盤 Flirting 持續高檔，娛樂城老面孔換皮回榜。芭樂子每週追蹤整理，保護你的錢包。`}
>
  <div class="container">
    <div class="breadcrumb"><a href="/">首頁</a> &gt; <a href="/articles/">芭樂攻略</a> &gt; 165 週報</div>
    <div style="color:var(--text-muted);font-size:0.8rem;margin-bottom:0.5rem">
      <Icon name="clock" /> 發佈日：{publishDate} ｜
      <Icon name="user-pen" /> 作者：芭樂子｜
      <Icon name="book-open" /> 預估閱讀 4 分鐘 ｜
      <span style="color:#f5b800;font-weight:700">🔍 165 監測站週報</span>
    </div>
    <a href="/articles/" class="back-link"><Icon name="arrow-left" /> 回攻略列表</a>
    <div class="hero-banner" style="background:linear-gradient(135deg,#0a0a1a,#1a1a3a,#ef4444)"></div>

    <article class="article-content" style="max-width:820px;margin:0 auto">
      <h1 style="font-size:1.8rem;line-height:1.3">🔍 165 監測站週報｜{weekLabel}<br /><em>「大河智贏」假投資空降榜首，殺豬盤持續高檔</em></h1>

      <p style="color:var(--text-muted);font-size:0.95rem">各位 8LA 鄉民好，我是芭樂子。每週我會從<strong>內政部警政署 165 全民防騙網</strong>的最新通報中，挑出跟<strong>娛樂城、博弈、假投資、殺豬盤</strong>這類「會把你錢騙光」的財務詐騙整理成週報。目的很簡單——<strong>讓你在入金、匯款之前，多一道防線</strong>。（冒用品牌的假購物詐騙不是本站專長，僅在文末帶過。）</p>

      <!-- === 本週摘要 === -->
      <div class="card" style="border-left:4px solid #ef4444;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#ef4444">⚠️ 本週摘要</h3>
        <p style="margin:0">165 本週（6/11–6/17）公布逾 <strong>150 筆</strong>「假投資（博弈）」詐騙通報，通報量前三為 <strong>TikTok</strong>（冒用品牌假購物）29 件、<strong>大河智贏</strong>（假投資）23 件、<strong>Flirting</strong>（殺豬盤）12 件。財務詐騙這邊，<strong>假投資「大河智贏」單週 23 件空降榜首</strong>；<strong>殺豬盤持續高檔</strong>（Flirting 12＋Deep Love club 6）；娛樂城類本週沒有單一主角，但老面孔 <strong>新葡京、必發</strong>又換新域名回榜。整體看，<strong>假投資平台仍是壓倒性大宗</strong>。</p>
      </div>

      <!-- === 165 總覽 === -->
      <div class="card" style="border-left:4px solid #44aaff;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#44aaff">📈 本週 165 通報總覽</h3>
        <p>本週「假投資（博弈）」類公告共列出逾 <strong>150 個</strong>詐騙網站，通報量前段：</p>
        <ul style="margin:0.5rem 0;line-height:2">
          <li><strong>TikTok</strong>（冒用品牌假購物）— 29 件</li>
          <li><strong>大河智贏</strong>（假投資）— 23 件</li>
          <li><strong>Flirting</strong>（殺豬盤假交友）— 12 件</li>
          <li><strong>TimeeCoin</strong>（假虛擬貨幣）— 9 件</li>
        </ul>
        <p style="margin-bottom:0">類型分布上，<strong>假投資平台</strong>（冒名券商、虛擬貨幣交易所、AI 智能量化）佔絕大多數；<strong>殺豬盤</strong>持續高檔；娛樂城／博弈品牌通報量分散，但這不代表變少——它們多半轉往社群、廣告、LINE 群這些更難被通報的管道。</p>
      </div>

      <!-- === 娛樂城／博弈 === -->
      <h2 id="casino" style="color:#ef4444">🎰 娛樂城／博弈：老面孔換皮、新殼站冒頭</h2>
      <p>本週娛樂城類沒有單一主角，但看點在「老面孔換新域名回榜」——這正好示範了詐騙娛樂城的本質：</p>
      <div class="weekly-brand-list">
        {casinoBrands.map(brand => (
          <div class="weekly-brand-card new-brand">
            <div class="brand-header">
              <span class="brand-badge updated">{brand.badge === '換皮' ? '🔁 換皮' : '🆕 新上榜'}</span>
              <strong>{brand.name}</strong>
              <span class="brand-count">{brand.count} 件</span>
            </div>
            <div class="brand-url">🌐 <code>{brand.url}</code></div>
            <p class="brand-note">💡 {brand.note}</p>
          </div>
        ))}
      </div>

      <!-- === 假投資 === -->
      <h2 id="invest" style="color:#f5b800">💰 假投資平台（本週大宗）</h2>
      <p>假投資是本週絕對主流——冒名券商、假交易所、AI 智能量化、虛擬貨幣，話術千變萬化，但結局都一樣：<strong>初期讓你看到帳面獲利，等你加碼，提領時就「不出金」</strong>。跟詐騙娛樂城是同一套劇本，只是包裝不同。本週由 <strong>大河智贏（23 件）</strong>領銜，通報量前段：</p>
      <div class="scam-table-wrap">
        <table class="scam-table">
          <thead><tr><th>品牌</th><th>網址</th><th>件數</th></tr></thead>
          <tbody>
            {investScams.map(s => (
              <tr><td>{s.name}</td><td><code>{s.url}</code></td><td class="ct">{s.count}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- === 殺豬盤 === -->
      <h2 id="romance" style="color:#ec4899">💔 殺豬盤：先談感情，再騙你投資</h2>
      <p>本週殺豬盤持續高檔，Flirting 一個品牌就被通報 12 件。套路是<strong>先用「正妹／帥哥」假交友養感情</strong>，幾天後再「不小心」透露自己有內線投資管道，把你導去假平台或假博弈。本週上榜的假交友幌子：</p>
      <div class="scam-table-wrap">
        <table class="scam-table">
          <thead><tr><th>品牌</th><th>網址</th><th>件數</th></tr></thead>
          <tbody>
            {romanceScams.map(s => (
              <tr><td>{s.name}</td><td><code>{s.url}</code></td><td class="ct">{s.count}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- === 趨勢觀察 === -->
      <h2 id="trend">📊 本週趨勢觀察</h2>
      <div class="card" style="border-left:4px solid #f5b800;margin:1.5rem 0">
        <h3 style="margin-top:0;color:#f5b800">芭樂子觀察筆記</h3>
        <p><strong>1. 「大河智贏」空降榜首，一看域名就知道是即棄殼</strong>——它的網址是 <code>071f171tu.1vpbia9fl.com</code>，這種一長串隨機英數的子網域，是機器批次產生、被檢舉就丟的拋棄式網址。<strong>正規投資平台不會用這種域名。</strong>「智贏／智能／量化」這類名字＋亂碼網址，幾乎就是假投資的標配。</p>
        <p><strong>2. 假投資 ＝ 不出金娛樂城的雙胞胎</strong>——大河智贏、TimeeCoin、FIDU 這些假投資平台，跟詐騙娛樂城是同一套：帳面假獲利 → 誘你加碼 → 提領時各種理由拖延凍結。手法一模一樣，只是一個包成「投資」、一個包成「博弈」。看懂一個，就看得懂另一個。</p>
        <p style="margin-bottom:0"><strong>3. 娛樂城看域名紀錄，不看名字</strong>——這週新葡京又冒新殼 m.k937765.com、必發又換 betfairae.com。這兩個都是累犯集團，證明詐騙娛樂城根本不在乎「品牌信譽」，賺一票就換域名跑。<strong>判斷該不該信，要查網域與紀錄，不是看名字。</strong>還有這週一堆 <code>.cc</code>、<code>.top</code>、<code>.vip</code>、<code>.love</code> 的怪域名——正規平台不會用這種便宜即丟的頂級域名。</p>
      </div>

      <!-- === CTA === -->
      <div class="casino-check-cta" style="background:linear-gradient(135deg,#0a1a2e,#1a2a4a);border:2px solid #f5b800;border-radius:12px;padding:2rem;text-align:center;margin:2rem 0">
        <h3 style="color:#f5b800;margin-top:0;font-size:1.3rem">🔍 擔心你玩的娛樂城／平台在黑名單上？</h3>
        <p style="color:#ccc;margin-bottom:1.2rem">把網址丟進「娛樂城體檢」，一秒比對 165 詐騙黑名單 + WHOIS 網域年齡 + 鄉民不出金回報</p>
