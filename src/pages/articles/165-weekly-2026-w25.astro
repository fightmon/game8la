---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ManifestoBox from '../../components/ManifestoBox.astro';
import ShareButtons from '../../components/ShareButtons.astro';

const weekLabel = '2026 第 25 週（6/11–6/17）';
const publishDate = '2026-07-09';

/* ── 娛樂城／博弈類（本週：老面孔換皮＋新殼站） ── */
const casinoBrands = [
  { name: '新葡京娛樂城', url: 'm.k937765.com', count: 1, badge: '換皮', note: '165 黑名單的「域名之王」——累計逾 200 件通報、幾十個 m.bycp…、m.kqxs… 系列即棄網域。這週又冒出新殼 m.k937765.com。老招不變：換一個新域名繼續同一套不出金。看到「新葡京」但網址是隨機英數的 m.xxxx.com，直接跳過。' },
  { name: '必發國際娛樂', url: 'betfairae.com', count: 1, badge: '換皮', note: '「必發」系列老面孔（betfairos／betfairse／betfairo 都被通報過），這週新域名 betfairae.com。名字蹭國際運彩品牌 Betfair 想借光，實際是同一票人、同一套劇本。' },
